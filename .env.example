# 0dot — environment variables
#
# Copy this file to `.env` for local development and fill in real values.
# Never commit `.env`, `.env.local`, or `.env.production.local` — only this
# file (`.env.example`) is meant to be tracked in git.
#
# Every var below is read directly by the app code (grepped from src/,
# scripts/, prisma.config.ts) — this list should stay in sync with that.
# Vercel/Turborepo also inject their own platform vars at build/runtime
# (VERCEL, VERCEL_ENV, VERCEL_GIT_*, VERCEL_OIDC_TOKEN, TURBO_*, NX_DAEMON,
# STRIPE_MCP_KEY, DATA_*) — those are managed by Vercel itself and never
# belong in this file. Marketplace integrations manage another set:
# Vercel Blob -> BLOB_READ_WRITE_TOKEN; Upstash -> KV_REST_API_* / KV_URL /
# REDIS_URL; Turso -> TURSO_DATABASE_URL / TURSO_AUTH_TOKEN (the app reads
# DATABASE_URL / DATABASE_AUTH_TOKEN, set alongside them). Preview and
# Production each have their own isolated Turso database.

# ── Database (required) ─────────────────────────────────────────────────
# Local dev: a plain SQLite file. Production: a libsql/Turso URL — get both
# from `turso db show <name> --url` and `turso db tokens create <name>`.
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=

# ── Realtime backplane (optional) ───────────────────────────────────────
# Cross-instance pub/sub for every SSE surface (DMs, notifications,
# community chat, voice-room state) — src/lib/realtime/. Provisioned by the
# "Upstash for Redis" Vercel Marketplace integration
# (`vercel integration add upstash/upstash-kv`), which injects these on
# Vercel automatically. Unset (local dev without it) = the in-memory
# single-process driver, which is correct for one process. See
# docs/specs/addendum-realtime-community.md §4.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────
# Absolute origin used to build links in outgoing email (verification,
# password reset, newsletter unsubscribe). Falls back to localhost in dev.
APP_ORIGIN="http://localhost:3000"

# ── Security ─────────────────────────────────────────────────────────────
# Message content encryption at rest (src/lib/message-crypto.ts). 256-bit
# key, base64-encoded. Generate one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse a dev value in production.
MESSAGE_ENCRYPTION_KEY=

# Signed download-link tokens (src/lib/protected-storage.ts). Falls back to
# an insecure hardcoded dev value if unset — must be set in production.
DOWNLOAD_TOKEN_SECRET=

# Secret for the platform-cron routes (/api/cron/frequent|hourly|daily).
# Set as a Vercel env var AND a GitHub Actions repo secret of the same name.
# The daily bucket is a native Vercel cron (vercel.json) — Vercel sends this
# as a Bearer token automatically. The frequent/hourly buckets are triggered
# by .github/workflows/cron.yml (Hobby plan can't do sub-daily crons), which
# sends the same header. Unset = the cron routes refuse all requests (503).
# Not needed in local dev — the recurring jobs run in-process there (see
# instrumentation.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Dev-only escape hatch: allows the unauthenticated SSO stub verifier to run
# outside NODE_ENV=production, for a deliberate, trusted staging test only.
# Leave unset everywhere else.
ALLOW_STUB_SSO=

# ── Sentry (error tracking — web-pro-upgrade addendum M1) ───────────────
# All injected on Vercel by the Vercel↔Sentry marketplace integration; unset
# locally = Sentry.init never runs, zero overhead (src/instrumentation.ts,
# src/instrumentation-client.ts). NEXT_PUBLIC_SENTRY_DSN is NOT a separate
# var in prod — next.config.ts fills it from SENTRY_DSN at build time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Source-map upload token (production builds only; near-no-op without it).
SENTRY_AUTH_TOKEN=
# Set to "1" to turn on the Sentry SDK's verbose debug logging.
SENTRY_DEBUG=

# ── AI (bio-writing, article drafting) ──────────────────────────────────
# src/lib/ai-provider.ts. Unset = stub provider (no real model calls).
ANTHROPIC_API_KEY=

# ── Email (src/lib/email.ts) ─────────────────────────────────────────────
# Leaving SMTP_HOST unset falls back to a console-log stub — no real email
# sent, dev-only. Works with any SMTP relay (Resend, SES, Postmark, Mailgun).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="0dot <verify@0dot.in>"
# Only needed if EMAIL_FROM is unset — the fallback From: domain.
RESEND_EMAIL_DOMAIN="0dot.in"
# Only needed for the Resend-specific API path, if used instead of SMTP.
RESEND_API_KEY=

# ── SMS (stubbed — no real provider implemented yet) ────────────────────
# Leave unset for the console-log stub. Any other value throws until a real
# provider is added to src/lib/sms.ts.
SMS_PROVIDER=

# ── Payments (Stripe) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Publishable key — safe to expose; the NEXT_PUBLIC_ copy is what the
# browser Stripe.js / Elements bundle reads. Keep both in sync.
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Only the newer "thin payload" webhook route (webhook-v2) checks this —
# the legacy webhook route uses STRIPE_WEBHOOK_SECRET above.
STRIPE_THIN_WEBHOOK_SECRET=

# ── LiveKit (livestreams + community voice rooms) ──────────────────────
# One LiveKit Cloud project powers both livestreams
# (src/lib/livestream-provider.ts) and community voice rooms
# (src/lib/voice-livekit.ts — realtime addendum Phase D, which replaced the
# old STUN-only WebRTC mesh; NEXT_PUBLIC_VOICE_STUN_URLS is gone). Sign up
# free at https://cloud.livekit.io. Leaving any of the three unset falls
# back to a stub — livestreams get scheduling/gating/chat only, voice rooms
# get the floor queue but no audio. Also register the webhook
# `<APP_ORIGIN>/api/webhooks/livekit` in the LiveKit project settings so a
# closed room reconciles back to the DB.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Mobile app download links (/download page) ──────────────────────────
ANDROID_APK_DOWNLOAD_URL=
IOS_TESTFLIGHT_URL=

# ── DB backup script (scripts/backup-db.mjs) ─────────────────────────────
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=14

# ── Coin wallet / UPI payouts (not yet wired into code — see
# docs/specs/addendum-coin-wallet.md) ────────────────────────────────────
PLATFORM_UPI_VPA=
PLATFORM_UPI_PAYEE_NAME=
