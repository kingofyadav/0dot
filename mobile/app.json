{
  "expo": {
    "name": "0dot",
    "slug": "0dot",
    "owner": "kingofyadav",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": [
      "zerodot-ios",
      "zerodot-android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.0dot.ios",
      "icon": {
        "light": "./assets/ios-icon-light.png",
        "dark": "./assets/ios-icon-dark.png",
        "tinted": "./assets/ios-icon-tinted.png"
      },
      "associatedDomains": [
        "applinks:0dot.in"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "0dot uses your microphone so you can speak in community voice rooms.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "in.zerodot.android",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "0dot.in"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "50c9f08d-e5bf-45fa-883c-1995c81846f2"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow 0dot to use Face ID to unlock the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow 0dot to access your photos to attach them to posts and your profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@sentry/react-native/expo",
      "expo-sharing",
      "expo-audio",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "0dot uses your microphone so you can speak in community voice rooms."
        }
      ],
      "expo-asset",
      "./plugins/withAndroidLauncherRecovery"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/50c9f08d-e5bf-45fa-883c-1995c81846f2"
    }
  }
}
