// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  // E.164 ("+<dialcode><digits>", see country-codes.ts toE164). Required at
  // signup going forward (auth.ts) but stays nullable in the DB — every
  // account created before this field existed predates it. Unique so a
  // future "log in with email, username, or phone" flow (product ask logged
  // alongside this field) can look one up unambiguously; no verification
  // step yet, same "collect now, verify later" posture as email's
  // console-logged dev link.
  phone           String?   @unique
  passwordHash    String
  status          String    @default("active") // active | suspended | deactivated | deleted
  // phase-4 build plan decision #1: manually granted via direct DB access,
  // same "no self-serve flow" posture as Profile.isVerified. Gates
  // /admin/businesses, the review queue for businesses that don't clear the
  // weak-signal auto-approval in businesses.ts.
  isPlatformAdmin Boolean   @default(false)
  // phase-12 spec §8.1/§8.2: nullable — every account created since Phase 1
  // predates this field. An unknown DOB gets the default protective
  // restriction set (age-controls.ts) until the user is prompted at next
  // login, never treated as an adult by default.
  dateOfBirth     DateTime?
  ageVerifiedAt   DateTime? // set only if a stronger check (e.g. ID) went beyond self-reported DOB
  // phase-13 spec §4.3: incremented on each valid, unrebutted DMCA takedown
  // against content this user posted — a safe-harbor condition, not a
  // cosmetic counter (see enforceDmcaStrikeThreshold in dmca.ts).
  dmcaStrikeCount Int       @default(0)
  // Chat presence ("online"/"last active X ago" — the messaging inbox's
  // green-dot indicator): bumped on SSE connect/disconnect (see
  // src/lib/presence.ts, api/messages/stream/route.ts), not a heartbeat
  // polled on every request. "Online right now" is answered by the
  // in-memory connection-count map in presence.ts instead — this column is
  // only the durable fallback for "last seen" once nobody's connected,
  // same single-process-for-now posture message-events.ts documents.
  lastActiveAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // account-settings-hardening addendum §2/§3: base32 TOTP secret, plain —
  // matches this codebase's existing "trust the DB" posture (nothing else
  // is field-encrypted, e.g. phone above). twoFactorEnabledAt null means
  // either never enrolled or mid-enrollment (secret set, first code not yet
  // confirmed) — confirmTwoFactorEnrollment is what sets it.
  twoFactorSecret        String?
  twoFactorEnabledAt     DateTime?
  // addendum §11: account-level prefs, curated small lists at the app layer
  // (settings/preferences), not validated against a full IANA/locale DB here.
  locale                 String?
  timezone               String?
  // addendum §7: set by deactivateAccount/requestAccountDeletion, cleared by
  // reactivateAccount (login()) if the user returns before the sweeper
  // (account-deletion.ts) processes it.
  deletionScheduledFor   DateTime?
  // addendum §11: hand-serialized { reducedMotion, fontScale, highContrast }
  // — matches this schema's "no native Json scalar" convention (hoursJson,
  // imagesJson, etc.), since Profile.themePreset is about public profile
  // appearance, not personal reading prefs.
  accessibilityPrefsJson String?
  // platform-billing addendum §2.2, wired to real Stripe: cached so a payer
  // reuses one Stripe Customer across every checkout (premium profile,
  // business subscription) instead of Stripe minting a new one per session
  // — created lazily on first checkout (getOrCreateStripeCustomerId,
  // stripe.ts), never written any other way.
  stripeCustomerId       String?   @unique
  // Internal coin wallet balance, separate from Stripe entirely — funded via
  // manually-reviewed UPI top-ups (CoinTopUpRequest) and a 1-coin signup
  // bonus, 1 coin = $1 (see USD_COIN_TO_INR_RATE in upi.ts). Spent via
  // purchaseProfilePremiumWithCoins (platform-billing.ts) — the coin-funded
  // alternative to Stripe Checkout for Premium Profile.
  coinBalance            Int       @default(0)
  // The user's own UPI VPA, on file for a future coin-to-cash payout —
  // deliberately separate from CreatorPayoutAccount, which is Stripe-only.
  payoutUpiVpa           String?

  username                        Username?
  profile                         Profile?
  sessions                        Session[]
  deviceTokens                    DeviceToken[]
  notificationDeliveryPreferences NotificationDeliveryPreference[]

  emailVerificationTokens    EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  twoFactorRecoveryCodes     TwoFactorRecoveryCode[]
  pendingTwoFactorChallenges PendingTwoFactorChallenge[]
  coinTopUpRequests          CoinTopUpRequest[]
  coinPayoutRequests         CoinPayoutRequest[]
  coinTransfersSent          CoinTransfer[] @relation("CoinTransferSent")
  coinTransfersReceived      CoinTransfer[] @relation("CoinTransferReceived")
  pendingEmailChanges        PendingEmailChange[]
  pendingPhoneChanges        PendingPhoneChange[]
  loginEvents                LoginEvent[]
  posts                      Post[]
  postLikes                  PostLike[]
  bookmarks                  Bookmark[]
  pollVotes                  PollVote[]

  // Follow rows where this user is the follower ("who I follow") vs. the
  // followee ("who follows me") — named relations since both sides of the
  // edge point back to User.
  following  Follow[] @relation("Follower")
  followedBy Follow[] @relation("Followee")

  blocksMade     Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")

  notifications       Notification[] @relation("NotificationRecipient")
  notificationsCaused Notification[] @relation("NotificationActor")

  createdConversations       Conversation[]
  conversationParticipations ConversationParticipant[]
  sentMessages               Message[]
  initiatedMessageRequests   MessageRequestState[]

  createdCommunities         Community[]
  communityMemberships       CommunityMember[]
  modActionsTaken            ModAction[]
  wikiRevisions              WikiRevision[]
  communityChatMessages      CommunityChatMessage[]
  communityMembershipEvents  CommunityMembershipEvent[]
  createdVoiceRooms          VoiceRoom[]                @relation("VoiceRoomCreator")
  currentSpeakerInVoiceRooms VoiceRoom[]                @relation("VoiceRoomCurrentSpeaker")
  voiceRoomParticipations    VoiceRoomParticipant[]

  createdOrganizations     Organization[]
  organizationMemberships  OrganizationMember[]
  ssoIdentities            SSOIdentity[]
  organizationAuditActions OrganizationAuditLog[]

  createdBusinesses   Business[]
  businessMemberships BusinessMember[]
  sentContactMessages ContactMessage[]
  reviews             Review[]
  reviewResponses     ReviewResponse[]
  jobApplications     JobApplication[]

  availabilityRulesAsStaff  AvailabilityRule[] @relation("AvailabilityRuleStaff")
  appointmentsAsCustomer    Appointment[]      @relation("AppointmentCustomer")
  appointmentsAsStaff       Appointment[]      @relation("AppointmentStaff")
  uploadedBusinessDocuments BusinessDocument[]

  payoutAccount              CreatorPayoutAccount?
  paymentTransactionsAsPayer PaymentTransaction[]  @relation("PaymentTransactionPayer")
  paymentTransactionsAsPayee PaymentTransaction[]  @relation("PaymentTransactionPayee")
  tipsSent                   Tip[]                 @relation("TipFrom")
  tipsReceived               Tip[]                 @relation("TipTo")

  membershipTiers         MembershipTier[]
  membershipSubscriptions MembershipSubscription[]

  digitalProducts         DigitalProduct[]
  digitalProductPurchases DigitalProductPurchase[]

  courses            Course[]
  courseAccessGrants CourseAccessGrant[]
  courseProgress     CourseProgress[]

  podcasts          Podcast[]
  podcastFeedTokens PodcastFeedToken[]

  newsletterCreated    NewsletterSubscription[] @relation("NewsletterCreator")
  newsletterSubscribed NewsletterSubscription[] @relation("NewsletterSubscriber")
  newsletterIssues     NewsletterIssue[]

  affiliatePrograms AffiliateProgram[]
  affiliateLinks    AffiliateLink[]

  livestreams            Livestream[]
  livestreamChatMessages LivestreamChatMessage[]

  projects              Project[]
  projectCollaborations ProjectCollaborator[]
  projectLikes          ProjectLike[]
  projectComments       ProjectComment[]
  skillEndorsements     SkillEndorsement[]

  articles  Article[]
  reactions Reaction[]
  comments  Comment[]

  hostedEvents  Event[]     @relation("EventHostedByUser")
  createdEvents Event[]     @relation("EventCreatedBy")
  eventRSVPs    EventRSVP[]
  tickets       Ticket[]    @relation("TicketOwner")

  // phase-9 spec §3.2: an individual freelancer is a second owner kind on
  // the same Offering/AvailabilityRule/Appointment trio Phase 4 built for
  // businesses — named relations since Appointment already has two other
  // User relations (customer, teamMember) pointing back here.
  offeringsAsSeller         Offering[]         @relation("OfferingSeller")
  availabilityRulesAsSeller AvailabilityRule[] @relation("AvailabilityRuleSeller")
  appointmentsAsSeller      Appointment[]      @relation("AppointmentSeller")
  offeringPurchases         OfferingPurchase[]

  marketplaceListingsSold     MarketplaceListing[]
  marketplacePurchases        MarketplacePurchase[]
  marketplaceListingReviews   MarketplaceListingReview[]
  marketplaceListingResponses MarketplaceListingReviewResponse[]

  developerApps       DeveloperApp[]
  oauthAuthCodes      OAuthAuthorizationCode[]
  oauthAuthorizations OAuthAuthorization[]

  aiGenerations          AIGeneration[]
  moderationFlagsHandled ModerationFlag[]
  uploadedFileAssets     FileAsset[]

  trustSafetyStaffRole     TrustSafetyStaffRole?
  trustSafetyCasesReported TrustSafetyCase[]     @relation("TrustSafetyCaseReporter")
  trustSafetyCasesAssigned TrustSafetyCase[]     @relation("TrustSafetyCaseAssignee")
  reportsFiled             Report[]
  appealsFiled             Appeal[]              @relation("AppealFiledBy")
  appealsReviewed          Appeal[]              @relation("AppealReviewedBy")
  accountRiskSignals       AccountRiskSignal[]

  contentRevisions       ContentRevision[]
  dmcaCounterNotices     DMCACounterNotice[]
  ownershipTransfersFrom OwnershipTransfer[] @relation("OwnershipTransferFrom")
  ownershipTransfersTo   OwnershipTransfer[] @relation("OwnershipTransferTo")

  // phase-16: Future Modules
  jobAlerts            JobAlert[]
  shortLinks           ShortLink[]
  formResponses        FormResponse[]
  fundraisingCampaigns FundraisingCampaign[] @relation("FundraisingCampaignOrganizerUser")
  donationsMade        Donation[]
  learningPaths        LearningPath[]
  quizAttempts         QuizAttempt[]
  crmContacts          Contact[]
}

model Session {
  id        String   @id @default(uuid())
  // sha256(raw token) — the raw 256-bit token only ever lives in the
  // httpOnly cookie (session.ts's createSession/getCurrentUser), never at
  // rest here, so a DB read exposure (backup snapshot, replica, an
  // over-broad query) can't yield directly-usable session tokens. Same
  // "store a hash, not the secret" posture two-factor.ts's recovery codes
  // and auth.ts's password-reset tokens already use.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  // account-settings-hardening addendum §4: populated by createSession
  // (session.ts) and touched on every getCurrentUser() read — backs the
  // active-sessions/device-management settings page.
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
}

// addendum §2/§3: hashed with createHash("sha256"), never the raw code —
// same "account-takeover-capable secret" reasoning as PasswordResetToken.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// addendum §2/§3: short-TTL (5 min) row referenced by an httpOnly cookie
// between the password check and the TOTP check during login — mirrors
// Session's opaque-token-in-cookie shape, not a JWT.
model PendingTwoFactorChallenge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// addendum §2/§6: mirrors EmailVerificationToken's shape but kept as its own
// model — a pending *change* to an already-verified account is a different
// trust level than first-time signup verification, per that model's own
// comment about not reusing a lower-trust token type.
model PendingEmailChange {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// addendum §2/§6: no SMS provider exists yet (sms.ts's ConsoleSmsSender dev
// fallback) — codeHash follows the same sha256-at-rest posture as the
// two-factor recovery codes above, not the raw OTP.
model PendingPhoneChange {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newPhone  String
  codeHash  String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// addendum §2/§10: one row per login attempt (success and failure) plus
// every 2FA verification attempt — surfaced as login history on the active
// sessions settings page. Deliberately not alerting/emailing on suspicious
// entries here (out of scope, see addendum §1).
model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  success   Boolean
  method    String // password | totp | recovery_code

  @@index([userId, createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

// Account-recovery counterpart to EmailVerificationToken, deliberately not
// reusing that model: a password-reset token grants account takeover, not
// just email-ownership confirmation, so it gets two extra precautions that
// model doesn't need — the token is hashed at rest (tokenHash, never the raw
// value) so a DB read/backup leak can't be replayed directly, and its TTL
// (auth.ts's PASSWORD_RESET_TTL_MS) is 1h rather than 24h.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model Username {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle     String    @unique // stored lowercase; case-insensitive uniqueness enforced at the app layer
  claimedAt  DateTime  @default(now())
  releasedAt DateTime?
}

model Profile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String
  bio                  String   @default("")
  avatarUrl            String?
  coverUrl             String?
  themePreset          String   @default("default") // key into a fixed, curated preset list — never raw CSS
  isVerified           Boolean  @default(false)
  // Settings-page toggle: a private profile's posts/portfolio/links stay
  // hidden from any visitor who isn't the owner or an accepted follower
  // (see the isOwner/isFollowing gate on /[username]/page.tsx) — identity
  // (name/avatar/bio) and the Follow control itself always stay visible so
  // a stranger can still find and request to follow the account.
  isPrivate            Boolean  @default(false)
  // account-settings-hardening addendum §2/§9: live next to isPrivate above.
  // Enforcement at DM-send/tag-on-post/search call sites is deliberately
  // out of scope for this pass (addendum §1) — these back the settings UI
  // and persist the choice; each call site's own enforcement check is
  // flagged as follow-up where that action is implemented.
  allowDmsFrom         String   @default("everyone") // everyone | followers | none
  allowTagging         Boolean  @default(true)
  discoverableInSearch Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Denormalized, updated transactionally alongside the Follow row write
  // (phase-2 spec §3.1) — same pattern as Post's like/reply/repost counts.
  followerCount  Int @default(0)
  followingCount Int @default(0)

  // phase-6 spec §6.1: optional static alternative/supplement to the
  // generated resume view (§6.3) — same pre-signed-upload... well,
  // direct-filesystem-write pattern as every other upload in this codebase
  // (see uploads.ts), extended with a pdf allowlist entry.
  resumePdfUrl String?

  links           Link[]
  socialLinks     SocialLink[]
  skills          Skill[]
  workExperiences WorkExperience[]
  education       Education[]
  gitRepositories GitRepository[]
  researchPapers  ResearchPaper[]
  certificates    Certificate[]
  awards          Award[]

  wikiPages      WikiPage[]
  books          Book[]
  publishedFiles PublishedFile[]

  // phase-6 spec §8: reuses the same "small structured config blob on
  // Profile" pattern already established by Profile.themePreset, but that
  // one is a plain string key into a fixed preset list — portfolioLayoutJson
  // needs an *ordered list with a per-item toggle*, which doesn't fit a
  // single string. Follows BusinessLocation.hoursJson/Offering.imagesJson's
  // JSON-text-column precedent instead of a new table: an array of
  // {key, visible} parsed/validated at the app layer (src/lib/
  // portfolio-layout.ts), not the DB — no Zod anywhere in this codebase.
  portfolioLayoutJson String?

  // phase-9 spec §4.3: InstalledApp's installer_user_id is typed as a
  // Profile FK, not User — a deliberate departure from the seller-side XOR
  // (Offering.sellerUserId etc., which point at User), because an installed
  // widget attaches to the profile *page* as a display surface, the same
  // "Profile is the thing being rendered" reasoning WikiPage/Book's
  // profileId already uses, not an account-level relationship.
  installedApps InstalledApp[]

  // phase-16: Future Modules
  digitalBusinessCard DigitalBusinessCard?
  calendarEntries     CalendarEntry[]
  ownedForms          Form[]

  // Cross-post: schedule-once publishing to external social platforms —
  // ExternalSocialAccount/ScheduledCrossPost/CrossPostTarget below, same
  // profileId-scoped ownership as Link/SocialLink.
  externalSocialAccounts ExternalSocialAccount[]
  scheduledCrossPosts    ScheduledCrossPost[]

  // billing addendum §2 / premium-profiles addendum: the profile_premium
  // subscription and its included custom-domain slot (custom-domains
  // addendum §2.1's two-way owner XOR).
  platformSubscriptions PlatformSubscription[]
  customDomains         CustomDomain[]
}

model Follow {
  followerId String
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  // "pending" | "accepted". A row against a public account is created
  // "accepted" directly (unchanged prior behavior). A row against a private
  // account (Profile.isPrivate) starts "pending" and only flips to
  // "accepted" via acceptFollowRequest — followerCount/followingCount and
  // canViewFullProfile access both key off "accepted", not row existence,
  // so a private account's approval gate can't be bypassed by the mere act
  // of following (src/app/actions/follow.ts).
  status     String   @default("accepted")
  createdAt  DateTime @default(now())

  // followerId != followeeId is enforced at the app layer (followUser in
  // src/app/actions/follow.ts) — this schema has no other DB-level CHECK
  // constraints, so this doesn't introduce a new pattern.
  @@id([followerId, followeeId])
  @@index([followeeId, createdAt]) // "who follows this user" list, most-recent-first
  @@index([followerId, createdAt]) // "who this user follows" list, most-recent-first
}

// Minimal block primitive, pulled forward from Phase 12 Trust & Safety
// (phase-2 spec §5.6) — needed now so a blocked user's actions can be
// suppressed from generating notifications. Full T&S tooling (reports,
// appeals, automated detection) is not in scope here.
model Block {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId]) // "has X blocked me" reverse-direction lookup
}

// phase-2 spec §4, extended by phase-3 §15. actorId is nullable for future
// system notifications (none produced yet). type/subjectType are plain
// strings, not Prisma enums, per this schema's existing SQLite-string-enum
// convention (see User.status, PostMedia.type). `community_update` has
// producers now (new-follower-style single-recipient events only — see
// src/app/actions/community-rules.ts's comment on why rule/wiki edits
// don't fan out to every member yet); `community_invite` remains
// forward-compat only — no invite action exists to produce it.
model Notification {
  id          String    @id @default(uuid())
  recipientId String
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        String // like | comment | mention | new_follower | follow_request | follow_accepted | message | community_update | community_invite | business_review | job_application | application_status | appointment_request | appointment_confirmed | appointment_cancelled | tip_received | new_subscriber | affiliate_conversion | livestream_started | job_alert_match
  subjectType String // post | message | user | community | business | livestream | project | skill | article
  subjectId   String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt]) // list query, cursor-paginated
  @@index([recipientId, readAt]) // unread-count query
  @@index([recipientId, subjectId, type]) // dedup check + read-time aggregation grouping
}

model SocialLink {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  String // key into a fixed allowlist, validated at the app layer
  url       String
  position  Int
  createdAt DateTime @default(now())
}

// Cross-post: an OAuth-connected external social platform account a user
// can publish to. No live OAuth app credentials exist for any of these
// platforms yet (same posture as ai-provider.ts's model provider and
// payments.ts's payment processor) — see social-publish-provider.ts's
// stub connect flow. accessTokenEnc/refreshTokenEnc are encrypted at rest
// via message-crypto.ts's encryptAtRest/decryptAtRest, reused as-is since
// that helper is already generic (not message-specific) under the hood.
model ExternalSocialAccount {
  id                String    @id @default(uuid())
  profileId         String
  profile           Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform          String // key into a fixed allowlist, same posture as SocialLink.platform
  externalAccountId String // the platform's own user/page id
  displayName       String
  accessTokenEnc    String
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  status            String    @default("connected") // connected | expired | revoked
  connectedAt       DateTime  @default(now())
  // Connected content: stamped on every sync attempt regardless of outcome
  // (same "mark the attempt done" posture as GitRepository.lastSyncedAt),
  // so a failing account isn't retried every scheduler tick.
  lastContentSyncAt DateTime?

  targets      CrossPostTarget[]
  contentItems ExternalContentItem[]

  @@unique([profileId, platform, externalAccountId])
}

// Connected content: cached items pulled FROM a connected external account
// for display on the public profile (social-content-sync.ts) — the mirror
// image of CrossPostTarget, which pushes content TO the same accounts.
// Upserted on [externalAccountId, externalItemId] so a re-sync updates in
// place instead of duplicating.
model ExternalContentItem {
  id                String                @id @default(uuid())
  externalAccountId String
  externalAccount   ExternalSocialAccount @relation(fields: [externalAccountId], references: [id], onDelete: Cascade)
  externalItemId    String
  title             String
  thumbnailUrl      String?
  contentUrl        String
  publishedAt       DateTime?

  @@unique([externalAccountId, externalItemId])
  @@index([externalAccountId, publishedAt])
}

// Cross-post: a single user-composed post scheduled to fire once, at
// scheduledFor, to one or more connected external accounts. One row here
// fans out into one CrossPostTarget per selected platform below — status
// is a rollup of those targets' terminal states (see social-publish.ts).
model ScheduledCrossPost {
  id            String   @id @default(uuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content       String
  mediaUrlsJson String   @default("[]")
  scheduledFor  DateTime
  status        String   @default("scheduled") // scheduled | publishing | completed | failed | partially_failed | canceled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  targets CrossPostTarget[]

  @@index([status, scheduledFor])
}

// Cross-post: one platform's publish attempt within a ScheduledCrossPost,
// tracked independently so one platform failing doesn't block another —
// same status/attemptCount/lastAttemptedAt/nextRetryAt retry-with-backoff
// shape as WebhookDelivery/WebhookSubscription, fanned out per-target here
// instead of per-subscription.
model CrossPostTarget {
  id                String                @id @default(uuid())
  scheduledPostId   String
  scheduledPost     ScheduledCrossPost    @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  externalAccountId String
  externalAccount   ExternalSocialAccount @relation(fields: [externalAccountId], references: [id], onDelete: Cascade)
  status            String                @default("pending") // pending | publishing | published | failed
  externalPostId    String?
  externalPostUrl   String?
  errorMessage      String?
  attemptCount      Int                   @default(0)
  lastAttemptedAt   DateTime?
  nextRetryAt       DateTime?

  @@index([scheduledPostId])
  @@index([status, nextRetryAt])
}

// phase-4 gap-fill, spec §3.2: businessId is additive alongside the
// original profileId — both nullable, with "exactly one set" enforced at
// the app layer (createLink/profile.ts vs createBusinessLink/
// business-links.ts), same posture as ProjectCollaborator's userId/
// displayName XOR (phase-6): no partial/CHECK constraint support in this
// Prisma+SQLite setup. /r/[linkId] and getLinkStats stay untouched — both
// are already keyed on linkId alone, never profileId, so they work for
// business links for free.
model Link {
  id         String    @id @default(uuid())
  profileId  String?
  profile    Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String
  url        String
  position   Int
  isFeatured Boolean   @default(false)
  startsAt   DateTime?
  endsAt     DateTime?
  clickCount Int       @default(0)
  // premium-profiles addendum §5: set false by the downgrade sweep when a
  // lapsed profile_premium subscriber has more links than the free cap —
  // never deleted, hidden from the public profile until the count drops
  // back under the cap or premium resumes (instant reactivation, since
  // nothing was destroyed). Business links never gate on this — the raised
  // cap is a profile_premium-only perk (premium-profiles addendum §1 scope).
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  clicks LinkClick[]
}

model LinkClick {
  id           String   @id @default(uuid())
  linkId       String
  link         Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  occurredAt   DateTime @default(now())
  referrerHost String? // no raw IP/UA stored — see phase-1 spec §4.3 privacy rule

  @@index([linkId])
}

model Post {
  id            String    @id @default(uuid())
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  likeCount     Int       @default(0)
  replyCount    Int       @default(0)
  repostCount   Int       @default(0)
  // Denormalized, periodically recomputed by src/lib/trending.ts from a
  // windowed/time-decayed function of recent likes/replies/reposts — never
  // written synchronously on a like/reply/repost mutation (phase-2 spec
  // §6.2). Float, not Decimal: Prisma's SQLite connector doesn't support
  // the Decimal scalar (Postgres/MySQL only) and this only needs relative
  // ordering, not exact arithmetic — a deliberate deviation from the
  // spec's literal "decimal" pseudocode, not an oversight.
  trendingScore Float     @default(0)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  // phase-3 spec §7.1: a community post is still authored by a User
  // (authorId unchanged) and simply scoped to a community — likes/replies/
  // reposts/bookmarks/hashtags/mentions all work for free, no separate
  // content system. onDelete: Cascade is deliberate here (unlike the
  // NoAction self-relations below): deleteCommunity is already an
  // irreversible hard delete, so its posts going with it is consistent,
  // not a new data-loss risk.
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  // Community-scoped meaning only (spec §7.2) — never read outside a
  // community-feed query, so it has zero effect on Home/Explore ordering
  // by construction, not by a filter that could be forgotten.
  pinnedAt    DateTime?

  // phase-3 spec §6: moderator-curated per-community label, distinct from
  // the global user-generated Hashtag. onDelete: SetNull — deleting a
  // flair clears it from posts that used it, never touches the posts.
  flairId String?
  flair   CommunityPostFlair? @relation(fields: [flairId], references: [id], onDelete: SetNull)

  // phase-4 build plan step 2 / spec §5: resolves the authorship question
  // Phase 1 §7.1 and Phase 3 §7.1 both deferred. Deliberately NOT a
  // polymorphic author_type + author_id pair — one additive, nullable
  // column keeps every existing Post.authorId query correct by default.
  // authorId (the acting User) is always still set even when this is —
  // the human stays attributable for audit purposes even though the UI
  // shows the business as the visible author. onDelete: SetNull, same
  // reasoning as flairId above: losing the business shouldn't take the
  // post with it.
  businessAuthorId String?
  businessAuthor   Business? @relation(fields: [businessAuthorId], references: [id], onDelete: SetNull)

  // Posts are soft-deleted (deletedAt) only, never hard-deleted, so these
  // self-relations use NoAction rather than Cascade — a reply thread or
  // repost must never disappear because its target row was removed under
  // the hood; the app layer always tombstones instead.
  replyToId String?
  replyTo   Post?   @relation("PostReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Post[]  @relation("PostReplies")

  repostOfId String?
  repostOf   Post?   @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reposts    Post[]  @relation("PostReposts")

  // phase-3 spec §9: modeled as a Post variant, same reasoning as polls —
  // any reply (replyToId referencing this post) is a candidate answer; the
  // question's author or a moderator marks one as accepted. onDelete:
  // SetNull (not the NoAction the reply/repost self-relations use above):
  // this is a plain reference to an existing reply, not itself the thing
  // that must survive a delete — if that reply row were ever hard-deleted
  // (never happens today outside account-deletion cascade, but the schema
  // shouldn't assume that stays true), the question just loses its
  // accepted-answer pointer rather than the write failing.
  postType          String  @default("standard") // standard | question
  acceptedAnswerId  String?
  acceptedAnswer    Post?   @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  acceptedAnswerFor Post[]  @relation("AcceptedAnswer")

  likes     PostLike[]
  bookmarks Bookmark[]
  media     PostMedia[]
  // phase-3 spec §8.1: "a poll is an attachment to exactly one post" — not
  // community-exclusive, this Post-level attachment is what makes it work
  // in any feed for free, same reasoning as the rest of §7.1.
  poll      Poll?

  // phase-5 spec §4.2: the one gating mechanism reused (adapted per entity)
  // by podcast episodes, newsletter issues, course access, and livestreams
  // — never a second parallel gate. onDelete: SetNull, same reasoning as
  // flairId above: archiving/deleting a tier shouldn't take gated posts
  // down with it, just ungate them (matches the spec's silence on tier
  // deletion cascading content away, and errs toward not losing content).
  requiredTierId String?
  requiredTier   MembershipTier? @relation(fields: [requiredTierId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([replyToId])
  @@index([repostOfId])
  @@index([trendingScore])
  @@index([communityId, createdAt])
  @@index([communityId, flairId])
  @@index([requiredTierId])
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      String   @default("image") // image today; video later needs no migration
  url       String
  position  Int
  createdAt DateTime @default(now())

  @@index([postId])
}

// phase-3 spec §8.1: a poll is an attachment to exactly one post — not
// community-exclusive (a side effect of building it this way rather than
// community-specific, called out in the spec as intentional reuse, not
// scope creep).
model Poll {
  id                   String   @id @default(uuid())
  postId               String   @unique
  post                 Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  closesAt             DateTime
  allowsMultipleChoice Boolean  @default(false)

  options PollOption[]
}

model PollOption {
  id       String @id @default(uuid())
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label    String
  position Int

  votes PollVote[]

  @@index([pollId])
}

// Single-choice: the app layer removes any prior vote on the poll's other
// options before inserting a new one (spec §8.1's literal described
// behavior) — not a DB constraint, since multi-choice polls legitimately
// need more than one row per (poll, user).
model PollVote {
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([pollOptionId, userId])
}

model PostLike {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

model Bookmark {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

// phase-2 spec §5. Direct conversations always have exactly 2 participants,
// enforced at the app layer (src/lib/messaging.ts), not a DB constraint —
// group size limits are also application-level policy, same reasoning the
// spec itself gives for not constraining this in the schema.
model Conversation {
  id        String   @id @default(uuid())
  kind      String   @default("direct") // direct | group
  title     String? // group only; direct conversations have no title
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Denormalized so the inbox list (most-recent-activity-first, spec §5.5)
  // and the unread-badge check (spec §5.5: "count of conversations with
  // unread messages") never need a per-row subquery/join against Message —
  // same posture as Post's like/reply/repost counts.
  lastMessageAt       DateTime @default(now())
  lastMessageSenderId String?
  lastMessagePreview  String? // truncated body, or an attachment-type label

  // Set only for kind == "direct", to the two participant ids sorted and
  // joined (see messaging.ts's directKeyFor) — turns "at most one direct
  // conversation per pair" from a check-then-act race (a findFirst lookup
  // racing a create) into a DB-enforced guarantee: two concurrent creates
  // for the same pair compute the identical key, so the unique index lets
  // exactly one commit and the loser's P2002 is caught and turned into a
  // lookup of the winner. Null (not enforced) for group conversations and
  // any legacy row created before this column existed — SQLite's unique
  // index treats multiple NULLs as distinct, so those never collide.
  directKey String? @unique

  participants ConversationParticipant[]
  messages     Message[]
  requestState MessageRequestState?

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // member | admin — admin meaningful for group only
  joinedAt       DateTime     @default(now())

  // Derived-unread design (spec §5.5): one row update per "mark read," not
  // one row per message per recipient. A real FK (not a bare string), per
  // the spec's literal modeling — lets the unread check join straight to
  // the read message's createdAt instead of a second round-trip.
  lastReadMessageId String?
  lastReadMessage   Message? @relation("LastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  // Set when the *blocker* blocks a participant they share a direct
  // conversation with (phase-2 spec §5.6: "hidden from the blocker's inbox,
  // not deleted") — per-participant, not a conversation-wide delete.
  hiddenAt DateTime?

  @@id([conversationId, userId])
  @@index([userId, hiddenAt]) // "my conversation list" query
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String? // nullable if attachment-only

  // Discrete columns, not a jsonb blob — SQLite has no jsonb, and this
  // matches the existing PostMedia convention (type/url as real columns)
  // rather than introducing a new modeling style for this one feature.
  attachmentType      String? // file | voice_note
  attachmentUrl       String?
  attachmentMimeType  String?
  attachmentSizeBytes Int?
  attachmentDurationS Int? // voice_note only

  createdAt DateTime  @default(now())
  // Sender-only soft delete (spec §5.1). Deleting clears body/attachment*
  // columns immediately rather than just flagging the row — a true
  // tombstone, so there's no separate retention-window question to answer
  // (spec §7 flags retention policy as open; this sidesteps it rather than
  // guessing at a window) and no read-path filtering can ever leak content
  // that no longer exists in the DB.
  deletedAt DateTime?

  readByParticipants ConversationParticipant[] @relation("LastReadMessage")

  @@index([conversationId, createdAt])
}

// phase-2 spec §5.2. A DM from someone the recipient doesn't follow (and
// isn't followed by) starts pending, visible to the recipient in a separate
// requests list, not the primary inbox. No row at all for group
// conversations (spec: mutual/one-directional-follow conversations skip
// this state entirely and start accepted — same treatment as a group).
model MessageRequestState {
  conversationId String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         String       @default("pending") // pending | accepted | declined
  initiatedBy    String
  initiator      User         @relation(fields: [initiatedBy], references: [id], onDelete: Cascade)
}

// phase-3 spec §3.1. Slugs are a separate namespace from usernames
// (src/lib/reserved-community-slugs.ts, not reserved-usernames.ts) since
// they live under /c/ rather than the root path.
model Community {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String  @default("")
  avatarUrl   String?
  coverUrl    String?
  visibility  String  @default("public") // public | restricted | private — see §3.1
  createdBy   String
  creator     User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  // Denormalized, updated transactionally alongside CommunityMember writes
  // — same pattern as Profile.followerCount (phase-2 spec §3.1).
  memberCount Int @default(1)

  // phase-3 spec §10.1: "moderators only" (default, vandalism-resistant
  // before a community has established norms) or "members" (any active
  // member may edit).
  wikiEditPolicy String @default("moderators")

  // phase-14 spec §4.1: sixth instance of the additive-scope-column idiom
  // (Post.communityId/businessAuthorId/requiredTierId, Livestream/
  // VoiceRoom.eventId, MarketplaceListing.developerAppId). Layered on top
  // of, not replacing, `visibility` above — set only at creation
  // (createCommunity), so there's no retroactive-membership-purge case to
  // handle. onDelete SetNull: an organization going away un-restricts the
  // community rather than cascading into content deletion.
  restrictedToOrganizationId String?
  organization               Organization? @relation(fields: [restrictedToOrganizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          CommunityMember[]
  modActions       ModAction[]
  posts            Post[]
  rules            CommunityRule[]
  tags             CommunityTag[]
  flairs           CommunityPostFlair[]
  wikiPages        WikiPage[]
  chatMessages     CommunityChatMessage[]
  membershipEvents CommunityMembershipEvent[]
  voiceRooms       VoiceRoom[]
  hostedEvents     Event[]                    @relation("EventHostedByCommunity")
  installedApps    InstalledApp[]

  // phase-16: Future Modules
  ownedForms Form[]

  @@index([restrictedToOrganizationId])
}

// phase-3 spec §12.2, built as a deliberately narrower "walkie-talkie" mode
// (product decision, not the original spec's multi-speaker Spaces vision):
// exactly one participant holds the floor at a time (currentSpeakerId),
// everyone else listens, and a FIFO queue (VoiceRoomParticipant.
// requestedToSpeakAt) governs whose turn is next. This is what makes a
// plain client-side WebRTC mesh (src/lib/voice-signal-events.ts) viable
// without a real SFU media server: never more than one outbound audio
// stream active at once. See src/app/actions/voice-rooms.ts for the full
// state machine.
model VoiceRoom {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  status      String    @default("scheduled") // scheduled | live | ended
  startsAt    DateTime
  endedAt     DateTime?
  createdBy   String
  creator     User      @relation("VoiceRoomCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  // Who holds the floor right now; null = free. currentSpeakerSince backs
  // the self-healing "stale floor" check (isFloorFree in voice-rooms.ts) —
  // a lazy staleness check on read, same posture as trending.ts's
  // recompute guard, not a background job.
  currentSpeakerId    String?
  currentSpeaker      User?     @relation("VoiceRoomCurrentSpeaker", fields: [currentSpeakerId], references: [id], onDelete: SetNull)
  currentSpeakerSince DateTime?

  // phase-8 spec §6.2/§6.3: identical event-scoping and recording shape as
  // Livestream gains above — see that model's comment for the full
  // reasoning, not repeated here. This revisits Phase 3 §12.2's original
  // no-recording decision now that recording exists elsewhere in the
  // system, with the same consent-disclosure caveat.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  isRecorded             Boolean @default(false)
  recordingUrl           String?
  recordingRetentionDays Int?

  participants VoiceRoomParticipant[]

  @@index([eventId])
}

// No recording/playback (spec §12.2: a voice room's audio is live-only and
// not retained) — nothing here models storing audio at all, by design.
model VoiceRoomParticipant {
  voiceRoomId        String
  voiceRoom          VoiceRoom @relation(fields: [voiceRoomId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               String // speaker | listener | requesting_to_speak — "speaker" means holds the floor right now, not a persistent tier
  joinedAt           DateTime  @default(now())
  // FIFO queue order for the speak-request line; null = not queued. Only
  // ever set while role = requesting_to_speak.
  requestedToSpeakAt DateTime?

  @@id([voiceRoomId, userId])
}

// phase-3 spec §14: member growth (joins/leaves per day) is the one
// analytics metric that can't be derived from current state —
// leaveCommunity/banMember hard-delete the CommunityMember row, so
// historical leave dates aren't reconstructable without a log. The other
// three required metrics (post/comment volume, active member count, top
// posts) are direct queries over Post/CommunityChatMessage and don't need
// a table of their own — this is the one new table this step needs, not a
// general-purpose event log for everything.
model CommunityMembershipEvent {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // join | leave
  createdAt   DateTime  @default(now())

  @@index([communityId, createdAt])
}

// phase-3 spec §11.1: a new model, not reused Phase 2 Messaging —
// Conversation/Message is built around small participant sets with
// per-participant read cursors, wrong shape for a single broadcast channel
// with potentially thousands of members. No per-user read receipts/unread
// counts (impractical at chat volume, not how live chat behaves — it's a
// stream, not an inbox). deletedAt: moderator removal, tombstoned not
// hard-deleted for modlog accountability (ModAction remove_chat_message).
model CommunityChatMessage {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([communityId, createdAt])
}

// phase-3 spec §6: discovery tags attached to the community itself (search/
// browse filtering), from a shared curated taxonomy (src/lib/
// community-tags.ts), not free text — keeps discovery browsable rather
// than fragmented across one-off tags. Capped at a handful per community,
// enforced in setCommunityTags (src/app/actions/community-tags.ts), not
// here — SQLite has no clean way to express "max N rows per FK" at the
// schema level.
model CommunityTag {
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  tag         String

  @@id([communityId, tag])
}

// phase-3 spec §6: per-community, moderator-curated post label — distinct
// from CommunityTag (community-level, discovery) and from Phase 1's global
// Hashtag (user-generated, cross-community). color is a key into a fixed
// palette (src/lib/flair-colors.ts), never free-form CSS — same reasoning
// as Phase 1 theme presets (§3.6): customization without an XSS/contrast
// surface.
model CommunityPostFlair {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  label       String
  color       String

  posts Post[]

  @@index([communityId])
}

// phase-3 spec §4.1. Full role/status set (moderator role, banned/muted
// statuses — step 2's moderation tooling) is in active use, not just
// modeled ahead of time.
model CommunityMember {
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // owner | moderator | member
  status      String    @default("active") // active | pending | banned | muted
  joinedAt    DateTime  @default(now())

  @@id([communityId, userId])
  @@index([userId, status]) // "communities I'm an active member of" (§7's future "Your Communities" feed, and /c index)
}

// phase-3 spec §5. Simple ordered list, editable by moderators/owner only.
// No per-user acceptance tracking (spec explicitly defers that to a
// possible Phase 12 addition, not built speculatively here).
model CommunityRule {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  body        String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([communityId, position])
}

// phase-3 spec §10.1. currentRevisionId is nullable only to resolve the
// chicken-and-egg of creating a page's first revision (WikiRevision.
// wikiPageId needs the page to already exist) — never observably null to a
// reader: page + first revision are created together, currentRevisionId
// set in the same request before any read can see the gap
// (src/app/actions/wiki.ts's createWikiPage).
//
// phase-7 spec §5.1: communityId became nullable here, joined by profileId/
// bookId — a three-way ownership XOR (exactly one of the three set),
// enforced at the application layer in each dedicated create action
// (createWikiPage stays community-only; new profile/book actions set
// exactly one of the other two), same as this schema has no DB-level XOR
// constraint anywhere else (e.g. Link's profileId/businessId pair). Three
// separate compound uniques (one per owner) rather than one three-column
// unique, since SQLite/Prisma unique indexes treat each row's NULL columns
// as distinct — a community page and a profile page can freely share a
// slug string because the *other* two owner columns are null on both.
// kind/position both default so every existing Phase 3 community row is
// valid with zero backfill: kind defaults to "wiki" (community wikis
// already present the free-form, cross-linked shape §5.2 calls "wiki"
// presentation), position defaults to 0 (community pages are listed by
// title, not position — position only matters once parentPageId hierarchy
// is in play, i.e. profile/book-owned pages). parentPageId/visibility stay
// genuinely nullable per the spec's own wording — null for every existing
// community page, so nothing about community wikis changes.
model WikiPage {
  id                String        @id @default(uuid())
  communityId       String?
  community         Community?    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profileId         String?
  profile           Profile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookId            String?
  book              Book?         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  slug              String
  title             String
  kind              String        @default("wiki") // wiki | documentation | book_chapter — presentation only, spec §5.2
  parentPageId      String?
  parent            WikiPage?     @relation("WikiPageHierarchy", fields: [parentPageId], references: [id], onDelete: SetNull)
  children          WikiPage[]    @relation("WikiPageHierarchy")
  position          Int           @default(0)
  // meaningful only for profile/book-owned pages (spec §5.1) — community-
  // owned pages keep using Community.visibility unchanged and leave this
  // null, same "private is real access control" posture Article introduced
  // (§3.2), reused verbatim rather than reinvented.
  visibility        String?
  currentRevisionId String?       @unique
  currentRevision   WikiRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  revisions WikiRevision[] @relation("PageRevisions")

  @@unique([communityId, slug])
  @@unique([profileId, slug])
  @@unique([bookId, slug])
  @@index([profileId, parentPageId, position])
  @@index([bookId, parentPageId, position])
}

// Full revision history retained — every edit creates a new row,
// currentRevisionId repointed, never an in-place overwrite (spec §10.2's
// literal acceptance criterion). Two relations to WikiPage (PageRevisions:
// every revision that ever existed for a page; CurrentRevision: the one
// currently live) since a single "which page" FK can't also express "and
// is this the live one" without a redundant boolean.
model WikiRevision {
  id         String   @id @default(uuid())
  wikiPageId String
  wikiPage   WikiPage @relation("PageRevisions", fields: [wikiPageId], references: [id], onDelete: Cascade)
  body       String
  editedBy   String
  editor     User     @relation(fields: [editedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  currentFor WikiPage? @relation("CurrentRevision")

  @@index([wikiPageId, createdAt])
}

// phase-3 spec §13, step 2's "minimal ModAction log" — the community-scoped
// audit trail every moderator action (existing and new) writes through
// (src/lib/communities.ts's logModAction). `action` extends spec §13's
// literal enum (remove_post/remove_comment/remove_chat_message/mute_member/
// ban_member/pin_post/edit_rule/edit_wiki — several of which have no
// producer yet, since their underlying features aren't built) with the
// governance actions that already exist today and have real accountability
// value but weren't listed: appoint_moderator | remove_moderator |
// unmute_member | unban_member | transfer_ownership | end_voice_room |
// force_stop_speaker. Deliberately NOT written for
// approveJoinRequest/declineJoinRequest (routine intake, not a punitive
// action) or deleteCommunity (the log's own subject disappears with it,
// via Cascade below).
model ModAction {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  moderatorId String
  moderator   User      @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  action      String // see model comment for the full value set
  targetType  String // post | chat_message | user | rule | wiki_page
  targetId    String
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([communityId, createdAt])
}

// phase-4 build plan step 1 / spec §3.1. `status` isn't in the spec's own
// field list — it's the build plan's decision #1 answer to §3.3's
// launch-blocking claim gate: `pending` until a weak signal (creator's
// email domain matches the business's own website) or platform-admin
// approval promotes it to `active`. Only `active` businesses are
// public/searchable (enforced in the read paths, not here). No citext (this
// codebase is SQLite, see Community.slug) — case-insensitivity is handled
// by lowercasing at write time, same as every other slug namespace.
model Business {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  tagline     String   @default("")
  description String   @default("")
  logoUrl     String?
  coverUrl    String?
  category    String
  foundedYear Int?
  sizeRange   String? // solo | 2_10 | 11_50 | 51_200 | 201_1000 | 1000_plus
  isVerified  Boolean  @default(false) // stronger, manually-granted checkmark — separate from `status` (§3.3)
  status      String   @default("pending") // pending | active — see model comment
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // spec §11.1: denormalized off Review, recomputed transactionally on every
  // review create/update/delete (src/app/actions/reviews.ts) — same
  // denormalization pattern as Profile.followerCount/Community.memberCount.
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  members           BusinessMember[]
  locations         BusinessLocation[]
  contactInfo       ContactInfo?
  posts             Post[]
  contactMessages   ContactMessage[]
  offerings         Offering[]
  reviews           Review[]
  jobs              Job[]
  availabilityRules AvailabilityRule[]
  appointments      Appointment[]
  documents         BusinessDocument[]
  links             Link[]
  hostedEvents      Event[]               @relation("EventHostedByBusiness")
  payoutAccount     CreatorPayoutAccount?
  paymentsReceived  PaymentTransaction[]  @relation("PaymentTransactionPayeeBusiness")

  marketplaceListingsSold MarketplaceListing[]
  installedApps           InstalledApp[]

  developerApps DeveloperApp[]

  // phase-14 spec §2.1: optional link from the enterprise control-plane
  // entity back to this public-facing one — kept deliberately separate,
  // see Organization's own model comment.
  organizations Organization[]

  // phase-16: Future Modules
  ownedForms           Form[]
  fundraisingCampaigns FundraisingCampaign[]
  crmContacts          Contact[]

  // billing addendum §2 / custom-domains addendum §2.1: direct-to-platform
  // subscription (business_subscription plan) and its included custom-domain
  // slot — same two tables Profile gains below, XOR'd the same way.
  platformSubscriptions PlatformSubscription[]
  customDomains         CustomDomain[]

  @@index([status])
}

// spec §3.1: hoursJson is a deliberate, scoped exception to this codebase's
// "discrete columns, not jsonb" convention — business hours are a genuinely
// variable nested structure (multiple ranges per day for lunch-break
// splits) that doesn't decompose into fixed columns. Parsed/validated at
// the app layer, not the DB.
model BusinessLocation {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String
  address    String
  latitude   Float?
  longitude  Float?
  hoursJson  String? // {day: [{opens, closes}]}; empty/null = not listed, not "closed"

  @@index([businessId])
}

model ContactInfo {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String?
  phone      String?
  website    String?
}

// phase-4 build plan step 3 / spec §6.1: a simple inbound queue, status
// transitions only — no reply-in-app (replies happen over the email the
// sender provided; building in-app back-and-forth would duplicate Phase 2
// Messaging for a use case that doesn't need it). senderUserId nullable:
// null means a logged-out visitor submitted via name/email instead
// (senderName/senderEmail required at the app layer in that case, per
// spec §6.2's literal acceptance criterion).
model ContactMessage {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  senderUserId String?
  senderUser   User?    @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderName   String?
  senderEmail  String?
  body         String
  status       String   @default("new") // new | read | archived
  createdAt    DateTime @default(now())

  @@index([businessId, status, createdAt])
}

// phase-4 build plan step 4 / spec §7.1: products and services share one
// table (name/description/images/price/category) rather than two
// near-duplicate ones — kind picks between product-only fields (sku,
// stockStatus) and service-only fields (isBookable, durationMinutes), left
// null for the kind that doesn't use them, validated at the app layer
// (§7.2's two acceptance criteria), not enforced by the schema itself.
// imagesJson follows BusinessLocation.hoursJson's exact reasoning: a JSON
// array of up to 8 image URLs, same media-attachment shape as Phase 1 post
// media, without needing a second attachment table. price: Float, not
// Decimal — Prisma's SQLite connector doesn't support Decimal (same
// deviation Post.trendingScore already documents).
// phase-9 spec §3.2: businessId is now nullable, joined by sellerUserId —
// exactly one set, the same two-way owner XOR idiom Link (Phase 4 §3.2) and
// CreatorPayoutAccount (Phase 8 §5.2) already use, enforced at the app layer
// (createOffering, offerings.ts) not the DB (no partial-index/CHECK support
// in this Prisma+SQLite setup). Every pre-phase-9 row/call site keeps
// businessId set, sellerUserId null, unaffected.
model Offering {
  id              String    @id @default(uuid())
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sellerUserId    String?
  seller          User?     @relation("OfferingSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  kind            String // product | service
  name            String
  description     String    @default("")
  imagesJson      String? // JSON array of up to 8 image URLs; null/empty = none
  price           Float? // nullable = "contact for pricing"
  currency        String? // required iff price is set (§7.2)
  paymentLinkUrl  String? // build plan step 5: external checkout link; only meaningful when price is set, falls back to the contact form when absent
  status          String    @default("draft") // draft | active | archived
  // product-only, null for kind = service
  sku             String?
  stockStatus     String? // in_stock | out_of_stock | made_to_order
  // service-only, null for kind = product
  isBookable      Boolean?
  durationMinutes Int? // required when isBookable = true (§7.2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointments Appointment[]
  purchases    OfferingPurchase[]

  @@index([businessId, status])
  @@index([sellerUserId, status])
}

// phase-9 spec §3.1: resolves the Phase 4/5-flagged Store checkout
// deferral — native in-app checkout for an Offering, reusing the Phase 5
// payment ledger (recordPaymentTransaction) rather than a new transaction
// table. Fulfillment is a status enum the seller updates manually, same
// "don't build what wasn't asked for" restraint §7.1 already applied to
// inventory. paymentTransactionId is nullable to cover the free/
// contact-for-pricing path being routed here too would be wrong — it's
// only ever set because purchaseOffering (offerings.ts) requires a priced
// Offering to reach this table at all; unpriced offerings keep using the
// existing external-link/contact-form path untouched.
model OfferingPurchase {
  id                   String             @id @default(uuid())
  offeringId           String
  offering             Offering           @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  buyerId              String
  buyer                User               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  paymentTransactionId String             @unique
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  quantity             Int                @default(1)
  status               String             @default("pending") // pending | fulfilled | refunded
  createdAt            DateTime           @default(now())

  @@index([offeringId])
  @@index([buyerId])
}

// spec §4.1. `role` gates write permissions (owner > admin > editor > member,
// see src/lib/businesses.ts); `isPublic` is a fully independent concern —
// whether this row shows on the public Team tab. A `member`-role row can be
// `isPublic: true` and still have zero write permissions.
model BusinessMember {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("member") // owner | admin | editor | member
  title      String?
  isPublic   Boolean  @default(false)
  joinedAt   DateTime @default(now())

  @@id([businessId, userId])
  @@index([userId])
}

// build plan step 6 / spec §11.1: one review per (businessId, authorId) —
// editable, not stackable, enforced by the unique constraint below (also
// the upsert target for createOrUpdateReview). author_id is public
// (reviews are attributed, not anonymous) per spec §15.2.
model Review {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating     Int
  body       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  response ReviewResponse?

  @@unique([businessId, authorId])
  @@index([businessId])
}

// One official response per review — the unique PK on reviewId (not a
// separate id) is what enforces that, same shape as ContactInfo's
// businessId @id. responderId must be admin+ (src/lib/businesses.ts's
// isBusinessStaff), checked in the action, not the schema.
model ReviewResponse {
  reviewId    String   @id
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  responderId String
  responder   User     @relation(fields: [responderId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime @default(now())
}

// build plan step 7 / spec §9.1, §9.3: intentionally generic (no
// business-specific fields beyond businessId) so a future cross-business
// job board could query across every business's Job rows without a
// migration — no such board is built in Phase 4 itself.
model Job {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title          String
  description    String
  location       String?
  isRemote       Boolean   @default(false)
  employmentType String // full_time | part_time | contract | internship
  salaryMin      Float?
  salaryMax      Float?
  status         String    @default("open") // open | closed
  postedAt       DateTime  @default(now())
  closesAt       DateTime?

  applications JobApplication[]

  @@index([businessId, status])
}

// spec §15.2: resumeUrl/coverNote are visible only to admin+ team members
// and the applicant themself — enforced in the read path (jobs.ts query
// shape), not just hidden in the UI.
model JobApplication {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverNote   String   @default("")
  resumeUrl   String?
  status      String   @default("submitted") // submitted | reviewed | rejected | hired
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([applicantId])
}

// build plan step 8 / spec §10.2: MVP scope only — business-level
// availability (teamMemberId null throughout the booking flow this phase
// builds), no per-staff selection. The field exists so a future per-staff
// scheduling flow can use it without a migration, same "shape it generic,
// don't build the bigger thing" posture as Job/JobApplication in step 7.
// startsAtLocal/endsAtLocal are "HH:MM" strings, not a Time scalar — same
// deviation-for-SQLite-support reasoning as Post.trendingScore (Float, not
// Decimal). timezone is stored but not converted against — this codebase
// has no timezone-conversion infrastructure anywhere yet (BusinessLocation
// .hoursJson is display-only for the same reason); every date/time here is
// treated as wall-clock, a deliberate MVP simplification per §10.1's scope
// warning ("timezone handling... treat as signals to revisit scope").
// phase-9 spec §3.2: businessId nullable, joined by sellerUserId — same
// two-way owner XOR as Offering above. teamMemberId stays business-only
// (an individual seller has no team to assign a slot to; sellerUserId
// itself is the one person the slot belongs to).
model AvailabilityRule {
  id            String    @id @default(uuid())
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sellerUserId  String?
  seller        User?     @relation("AvailabilityRuleSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  teamMemberId  String?
  teamMember    User?     @relation("AvailabilityRuleStaff", fields: [teamMemberId], references: [id], onDelete: Cascade)
  dayOfWeek     Int // 0 (Sunday) - 6
  startsAtLocal String // "HH:MM", 24h
  endsAtLocal   String // "HH:MM", 24h
  timezone      String // IANA tz name, stored not converted (see model comment)

  @@index([businessId, teamMemberId, dayOfWeek])
  @@index([sellerUserId, dayOfWeek])
}

// spec §10.2/§10.3. build plan decision #3: a `requested` appointment DOES
// tentatively hold the slot — the overlap check below runs against every
// non-cancelled status, not just confirmed, so two customers can't both
// hold the same slot while it's pending.
// phase-9 spec §3.2: businessId nullable, joined by sellerUserId — same
// two-way owner XOR as Offering/AvailabilityRule above.
model Appointment {
  id           String    @id @default(uuid())
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sellerUserId String?
  seller       User?     @relation("AppointmentSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  offeringId   String?
  offering     Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  customerId   String
  customer     User      @relation("AppointmentCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  teamMemberId String?
  teamMember   User?     @relation("AppointmentStaff", fields: [teamMemberId], references: [id], onDelete: SetNull)
  startsAt     DateTime
  endsAt       DateTime // always derived from offering.durationMinutes at booking time — never client-supplied (§10.3)
  status       String    @default("requested") // requested | confirmed | cancelled | completed | no_show
  notes        String?
  createdAt    DateTime  @default(now())

  // spec §10.3's literal acceptance criterion: two non-cancelled
  // appointments for the same (businessId, teamMemberId) pair cannot
  // overlap, enforced transactionally in requestAppointment, not just in
  // the UI. This index backs that check.
  @@index([businessId, teamMemberId, startsAt])
  @@index([sellerUserId, startsAt])
}

// build plan step 9 / spec §12.1: a simple file library, no versioning
// (unlike Phase 3's wiki, which needed revision history for collaborative
// editing — these are typically business-controlled static assets; a
// re-upload is just a new row, the old one deletable). fileUrl reuses
// saveMessageAttachment's upload pipeline (src/lib/uploads.ts), not a
// third one. team_only visibility is enforced in the read path (§12.2's
// literal acceptance criterion), not just hidden in the UI.
model BusinessDocument {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  visibility String // public | team_only
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId, visibility])
}

// phase-5 build plan §0 / spec §3: one payout account per user. `processor`
// is named explicitly even though `StubPaymentProcessor` is the only
// implementation this session — the abstraction (src/lib/payments.ts's
// `PaymentProcessor` interface) is real, not aspirational, same reasoning
// the spec itself gives for naming the enum with one value. `status` is
// driven by processor.createPayoutAccount()/webhook confirmation, never a
// raw client-settable flag — see startCreatorOnboarding in
// src/app/actions/payments.ts.
// phase-8 spec §5.2: userId made nullable, businessId added — exactly one
// of userId/businessId set, the same two-way owner XOR idiom Link (Phase 4
// §3.2) already uses, not the three-way pattern Event hosting uses, since
// payout accounts only need two owner kinds so far. Communities
// deliberately do not get one here (spec §5.2: no monetization concept
// exists for communities anywhere in this system yet — community-hosted
// events stay RSVP-only, not a reason to invent a "community treasury").
model CreatorPayoutAccount {
  id                 String    @id @default(uuid())
  userId             String?   @unique
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId         String?   @unique
  business           Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  processor          String    @default("stub") // stub | stripe_connect
  processorAccountId String?
  status             String    @default("onboarding") // onboarding | active | restricted
  createdAt          DateTime  @default(now())
}

// phase-5 build plan §0 / spec §3.1: the one shared ledger every
// money-moving feature writes to (just Tip this session) via
// recordPaymentTransaction() in src/lib/payments.ts — no feature gets its
// own parallel transaction table. platformFee/amount are Float, not
// Decimal — SQLite deviation, same as Offering.price (phase-4 build plan
// step 4). platformFee is captured per-row at transaction time, not
// recomputed later from a global rate, so a future fee-rate change never
// rewrites the story of a past transaction (spec §3.2).
model PaymentTransaction {
  id                 String          @id @default(uuid())
  // phase-9 spec §3.1/§3.2/§4.3: business_purchase/freelance_purchase
  // resolve the Phase 4/5 Store checkout deferral (Offering, either owner
  // kind); marketplace_purchase is MarketplaceListing checkout (§4.3).
  // billing addendum §2.1/§4.1: platform_subscription_charge and
  // api_usage_charge are the one case in this whole ledger where there's
  // genuinely no payee (money flows straight to 0dot, not facilitated to a
  // third party) — payeeId/payeeBusinessId are both left null for these two
  // kinds, and platformFee equals the full charged amount (an honest
  // semantic mismatch the addendum flags rather than papers over).
  kind               String // tip | digital_purchase | course_purchase | membership_charge | affiliate_commission | ticket_purchase | business_purchase | freelance_purchase | marketplace_purchase | donation | platform_subscription_charge | api_usage_charge
  payerId            String?
  payer              User?           @relation("PaymentTransactionPayer", fields: [payerId], references: [id], onDelete: SetNull)
  // phase-8 build plan §5: payeeId made nullable, payeeBusinessId added —
  // exactly one set, enforced at the call site (purchaseTicket), not the
  // DB (no partial-index/CHECK support in this Prisma+SQLite setup, same
  // limitation Link/ProjectCollaborator already work around). A
  // business-hosted paid ticket's revenue belongs to the business's own
  // CreatorPayoutAccount (§5.2), not an individual staff member's ledger
  // row. Every pre-phase-8 call site (tip/digital/course/affiliate) is
  // unaffected — payeeId only, payeeBusinessId always null there.
  payeeId            String?
  payee              User?           @relation("PaymentTransactionPayee", fields: [payeeId], references: [id], onDelete: Cascade)
  payeeBusinessId    String?
  payeeBusiness      Business?       @relation("PaymentTransactionPayeeBusiness", fields: [payeeBusinessId], references: [id], onDelete: Cascade)
  amount             Float
  currency           String          @default("usd")
  platformFee        Float
  // phase-15 spec §6.2: CreatorPayoutAccount.processor's single-value enum
  // (phase-5 §3.1) finally gets a second value — a mobile app's native
  // purchase flow records against the store's own processor instead of
  // Stripe Connect where store policy requires it (spec §6.1). storeFee is
  // the store's own cut (historically 15-30%), deducted separately from
  // platformFee above, never conflated into one figure (§6.4).
  processor          String          @default("stripe_connect") // stripe_connect | apple_iap | google_play_billing
  storeFee           Float?
  iapPayoutBatchId   String?
  iapPayoutBatch     IapPayoutBatch? @relation(fields: [iapPayoutBatchId], references: [id], onDelete: SetNull)
  processorReference String
  status             String // pending | succeeded | failed | refunded
  relatedObjectType  String? // tip | digital_product | course | membership_tier | affiliate_link | ticket | offering | marketplace_listing | fundraising_campaign
  relatedObjectId    String?
  createdAt          DateTime        @default(now())

  tip                    Tip?
  digitalProductPurchase DigitalProductPurchase?
  courseAccessGrant      CourseAccessGrant?
  affiliateConversion    AffiliateConversion?
  ticket                 Ticket?
  offeringPurchase       OfferingPurchase?
  marketplacePurchase    MarketplacePurchase?
  donation               Donation?

  @@unique([processorReference, kind])
  @@index([payeeId, createdAt])
  @@index([payeeBusinessId, createdAt])
  @@index([payerId])
}

// addendum-platform-billing.md §2: direct-to-platform billing — money flows
// from a subscriber straight to 0dot, no payee, the opposite topology of
// every PaymentTransaction kind above. Collapses "Premium profiles,"
// "Business subscriptions," and "Enterprise plans" into one table (the
// `plan` enum) since all three are the identical flat-recurring-charge
// mechanic, differing only in who's paying and what they get. subscriber_*
// is a three-way XOR (profile | business | organization), enforced at the
// call site (subscribeProfilePremium/subscribeBusiness/etc. in
// src/lib/platform-billing.ts), same DB-constraint limitation noted
// elsewhere in this schema (no partial-index/CHECK support in this
// Prisma+SQLite setup).
model PlatformSubscription {
  id                       String        @id @default(uuid())
  subscriberType           String // profile | business | organization
  subscriberProfileId      String?
  subscriberProfile        Profile?      @relation(fields: [subscriberProfileId], references: [id], onDelete: Cascade)
  subscriberBusinessId     String?
  subscriberBusiness       Business?     @relation(fields: [subscriberBusinessId], references: [id], onDelete: Cascade)
  subscriberOrganizationId String?
  subscriberOrganization   Organization? @relation(fields: [subscriberOrganizationId], references: [id], onDelete: Cascade)
  plan                     String // profile_premium | business_subscription | enterprise
  status                   String        @default("active") // active | past_due | cancelled
  // premium-profiles addendum §4.1: not in the billing addendum's original
  // table — added once giving profile_premium proper depth required it.
  // Same monthly|yearly shape MembershipTier.billingInterval already uses.
  billingInterval          String        @default("monthly") // monthly | yearly
  processorSubscriptionId  String // external recurring-billing object is the source of truth for renewal state — same principle as MembershipSubscription (phase-5 §4.1)
  currentPeriodEnd         DateTime
  createdAt                DateTime      @default(now())

  @@index([subscriberProfileId, status])
  @@index([subscriberBusinessId, status])
  @@index([subscriberOrganizationId, status])
}

// addendum-custom-domains.md: lets a Profile or Business serve its public
// content from an owner-controlled domain in addition to its permanent
// 0dot.in URL. Two-way owner XOR (profile | business), not three —
// corrected from the platform-billing addendum's original three-way
// assumption once §2.2 of the fuller spec worked through Organization
// having no public page of its own to serve (it reaches this feature
// through whatever Business it's linked to, via ownerBusinessId, not a
// separate case). dnsTarget is per-row-unique and, by construction (a
// random token), never reused even across deleted rows — the standard
// defense against subdomain/domain-takeover (spec §5.2): a stale DNS
// record pointing at an orphaned target simply resolves to nothing, since
// no new claimant is ever issued that same string.
model CustomDomain {
  id                String    @id @default(uuid())
  ownerType         String // profile | business
  ownerProfileId    String?
  ownerProfile      Profile?  @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  ownerBusinessId   String?
  ownerBusiness     Business? @relation(fields: [ownerBusinessId], references: [id], onDelete: Cascade)
  domain            String    @unique
  isApex            Boolean // root domain (acme.com, needs ALIAS/ANAME/A records) vs. subdomain (links.acme.com, plain CNAME) — spec §4.2
  dnsTarget         String    @unique // e.g. "<token>.edge.0dot.in" — issued fresh per row, doubles as ownership proof once it resolves (spec §3/§4.1)
  routingStatus     String    @default("pending_dns") // pending_dns | routing_verified | routing_failed
  sslStatus         String    @default("pending") // pending | active | renewal_failed
  isPrimary         Boolean   @default(false)
  status            String    @default("active") // active | suspended_nonpayment | dormant | removed
  claimedAt         DateTime  @default(now())
  claimExpiresAt    DateTime // spec §4.3: an unverified claim past this is released back to the pool
  dormantAt         DateTime? // spec §5.3/§8.2: when this row entered `dormant` — retention window is computed from here, not deleted immediately
  lastHealthCheckAt DateTime?
  createdAt         DateTime  @default(now())

  @@index([ownerProfileId])
  @@index([ownerBusinessId])
  @@index([routingStatus])
  @@index([status])
}

// phase-5 build plan §1 / spec §6.1: the smallest feature exercising the
// backbone end-to-end — a thin wrapper around one PaymentTransaction, no
// subscription state, no access grant. message is public by default (spec
// §13.2's one deliberate exception to "financial data is private by
// default" — a visible "thank you" is often the point).
model Tip {
  id                   String             @id @default(uuid())
  fromUserId           String
  fromUser             User               @relation("TipFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toCreatorId          String
  toCreator            User               @relation("TipTo", fields: [toCreatorId], references: [id], onDelete: Cascade)
  amount               Float
  currency             String             @default("usd")
  message              String? // 0-280 chars, validated at the app layer
  paymentTransactionId String             @unique
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now())

  @@index([toCreatorId, createdAt])
}

// phase-5 spec §4.1: recurring paid access, optionally tiered. `level` is
// an ordering integer, not a foreign concept — "gates this level or
// higher" (spec §4.2) is computed entirely from comparing two `level`
// integers within the same creator, never a separate ranking table.
model MembershipTier {
  id              String   @id @default(uuid())
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name            String // 1-60 chars, validated at the app layer
  level           Int
  price           Float
  currency        String   @default("usd")
  billingInterval String // monthly | yearly
  description     String   @default("") // 0-1000 chars, validated at the app layer
  status          String   @default("active") // active | archived
  createdAt       DateTime @default(now())

  subscriptions         MembershipSubscription[]
  gatedPosts            Post[]
  gatedCourses          Course[]
  gatedPodcastEpisodes  PodcastEpisode[]
  gatedNewsletterIssues NewsletterIssue[]
  gatedLivestreams      Livestream[]

  @@index([creatorId, status])
}

// phase-5 spec §4.1: recurring billing state (renewal, decline retries,
// dunning) is delegated to the payment processor per §3.3/§4.1's own
// framing — status/currentPeriodEnd are a cache of what the processor
// reports, not independently computed here. This build's stub processor
// (src/lib/payments.ts) has no real recurring-billing webhook to drive
// that cache, so subscribeToTier sets currentPeriodEnd directly at
// creation time (one billing period out) — a documented stub limitation,
// not a real renewal engine; see src/app/actions/memberships.ts.
model MembershipSubscription {
  id                      String         @id @default(uuid())
  tierId                  String
  tier                    MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  fanId                   String
  fan                     User           @relation(fields: [fanId], references: [id], onDelete: Cascade)
  status                  String         @default("active") // active | past_due | cancelled
  currentPeriodEnd        DateTime
  processorSubscriptionId String
  createdAt               DateTime       @default(now())

  @@index([fanId, status])
  @@index([tierId, status])
}

// phase-5 spec §5: scoped to a creator selling from their own profile —
// spec §5.1 flags this is very likely the same feature as Phase 9's
// Marketplace "digital products," and recommends building the real model
// here so Phase 9 later adds cross-creator discovery on top of this same
// table rather than inventing a second product-and-purchase model.
// fileKey (not a public URL) is an opaque key into protected-storage.ts's
// storage/protected/ directory — never directly servable, only resolvable
// through a signed, purchase-checked download token (spec §5.3).
model DigitalProduct {
  id            String   @id @default(uuid())
  creatorId     String
  creator       User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title         String // 1-120 chars, validated at the app layer
  description   String   @default("") // 0-2000 chars, validated at the app layer
  price         Float
  currency      String   @default("usd")
  fileKey       String
  fileMimeType  String
  fileSizeBytes Int
  status        String   @default("draft") // draft | active | archived
  createdAt     DateTime @default(now())

  purchases DigitalProductPurchase[]

  @@index([creatorId, status])
}

// spec §5.4's literal criteria are enforced through this row, not the file
// itself: requestDownloadUrl (src/app/actions/digital-products.ts) only
// issues a token when a purchase row exists for the caller AND its linked
// PaymentTransaction hasn't been refunded — re-checked at request time, not
// baked into the token once at purchase time.
model DigitalProductPurchase {
  id                   String             @id @default(uuid())
  productId            String
  product              DigitalProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId              String
  buyer                User               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  paymentTransactionId String             @unique
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  purchasedAt          DateTime           @default(now())

  // A buyer never re-purchases the same product (purchaseProduct's own
  // "You already own this product" check assumes this), but that check ran
  // before the charge with no DB-level backstop against two concurrent
  // requests both passing it — same @@unique shape CourseAccessGrant
  // already uses for the identical "one grant per user" guarantee.
  @@unique([productId, buyerId])
  @@index([buyerId])
  @@index([productId])
}

// phase-5 spec §11: purchasable directly (one-time price) and/or bundled
// into a membership tier — both simultaneously is allowed, matching §11.1's
// prose. requiredTierId isn't in the spec's own §11.1 pseudocode listing,
// but is the same shared gate every other bundled-into-a-tier entity uses
// (§4.2: "reused for... course access") — without it there'd be no way to
// express which tier bundles a course, so this fills a gap the prose
// implies but the model listing omitted, rather than inventing a new
// mechanism. price/currency nullable together: a course can be
// tier-only-access with no standalone price (§11.1's own comment on price).
model Course {
  id             String          @id @default(uuid())
  creatorId      String
  creator        User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title          String // 1-120 chars, validated at the app layer
  description    String          @default("") // 0-2000 chars, validated at the app layer
  price          Float?
  currency       String?
  requiredTierId String?
  requiredTier   MembershipTier? @relation(fields: [requiredTierId], references: [id], onDelete: SetNull)
  status         String          @default("draft") // draft | active | archived
  createdAt      DateTime        @default(now())

  modules      CourseModule[]
  accessGrants CourseAccessGrant[]

  @@index([creatorId, status])
  @@index([requiredTierId])
}

model CourseModule {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String // 1-120 chars, validated at the app layer
  position Int

  lessons Lesson[]

  @@index([courseId, position])
}

// video_url/file_url in spec §11.1's pseudocode become fileKey/fileMimeType
// here — a protected-storage.ts key resolved only through the signed
// /api/downloads/[token] route (same §5.3 pre-signed-URL pattern this
// build already applies to digital-product files), never a literal
// servable URL. Same "security posture wins over literal spec pseudocode"
// deviation this schema already documents elsewhere (see trendingScore).
model Lesson {
  id            String       @id @default(uuid())
  moduleId      String
  module        CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String // 1-120 chars, validated at the app layer
  position      Int
  contentType   String // video | text | download
  body          String? // for contentType = text
  fileKey       String? // for contentType = video | download
  fileMimeType  String?
  fileSizeBytes Int?

  progress CourseProgress[]
  quizzes  Quiz[]

  @@index([moduleId, position])
}

// spec §11.1/§11.2: only ever written for grantedVia = "purchase" in this
// build — membership_tier-bundled access (the course's requiredTierId) is
// checked live via hasTierAccess (src/lib/tier-access.ts) every time,
// never materialized as a row, so it evaporates the instant a subscription
// lapses (spec §11.2's second criterion: "these are two independent grant
// types and must not be conflated"). paymentTransactionId is the typed
// equivalent of the spec's polymorphic source_id for the purchase case —
// same typed-fk-over-polymorphic-id precedent Post.businessAuthorId
// already set instead of an author_type+author_id pair.
model CourseAccessGrant {
  id                   String              @id @default(uuid())
  courseId             String
  course               Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedVia           String // purchase | membership_tier
  paymentTransactionId String?             @unique
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  createdAt            DateTime            @default(now())

  @@unique([courseId, userId])
}

// spec §11.2's third criterion: only ever written for a user who currently
// has access (checked in markLessonComplete, src/app/actions/courses.ts) —
// never a record of progress through content a user never had rights to.
model CourseProgress {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, lessonId])
}

// phase-5 spec §9: audio (episode.fileKey) reuses protected-storage.ts's
// save/stream pipeline — the same fileKey mechanism DigitalProduct/Lesson
// already use — not a public/uploads URL, even for ungated episodes.
// /api/podcasts/[episodeId]/audio (src/app/api/podcasts) is the one path
// in: it serves ungated episodes with no auth (a public RSS/HTTP client
// has no session to check) and gated episodes only with a valid, unrevoked
// PodcastFeedToken query param re-verified against live tier access every
// request — the "gating by obscurity plus revocability" §9.2 explicitly
// calls out as this ecosystem's real limit, not a gap in this build.
model Podcast {
  id          String   @id @default(uuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String // 1-120 chars, validated at the app layer
  description String   @default("") // 0-2000 chars, validated at the app layer
  coverUrl    String?
  rssSlug     String   @unique
  createdAt   DateTime @default(now())

  episodes   PodcastEpisode[]
  feedTokens PodcastFeedToken[]

  @@index([creatorId])
}

model PodcastEpisode {
  id             String          @id @default(uuid())
  podcastId      String
  podcast        Podcast         @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  episodeNumber  Int
  title          String // 1-120 chars, validated at the app layer
  description    String          @default("") // 0-2000 chars, validated at the app layer
  fileKey        String
  fileMimeType   String
  fileSizeBytes  Int
  durationS      Int
  publishAt      DateTime        @default(now())
  requiredTierId String? // spec §9.1: member-only bonus episodes, reuses §4.2's gate
  requiredTier   MembershipTier? @relation(fields: [requiredTierId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([podcastId, episodeNumber])
  @@index([requiredTierId])
}

// spec §9.2: one row per (podcast, subscriber) pair. `token` is embedded in
// a private feed URL (/podcast/[rssSlug]/rss.xml?t=token) that a podcast
// app polls with no login step — this row, not the token's cryptography,
// is what makes revocation real: verifyPodcastFeedToken (src/lib/
// podcasts.ts) checks revokedAt on every fetch, not just at issuance.
model PodcastFeedToken {
  id           String    @id @default(uuid())
  podcastId    String
  podcast      Podcast   @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   User      @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  token        String    @unique
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([podcastId, subscriberId])
}

// phase-5 spec §10: unsubscribeToken isn't in the spec's §10.1 field
// listing but is what actually implements §10.2's legally-required
// one-click unsubscribe link — same "fills a gap the prose implies but the
// model listing omitted" precedent Course.requiredTierId already set for
// §11. subscriberUserId nullable per spec (email-only subscribers with no
// 0dot account); subscriberEmail always set since that's who the issue
// actually gets sent to regardless of account linkage.
model NewsletterSubscription {
  id               String    @id @default(uuid())
  creatorId        String
  creator          User      @relation("NewsletterCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  subscriberUserId String?
  subscriberUser   User?     @relation("NewsletterSubscriber", fields: [subscriberUserId], references: [id], onDelete: SetNull)
  subscriberEmail  String
  unsubscribeToken String    @unique
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@unique([creatorId, subscriberEmail])
  @@index([creatorId])
}

model NewsletterIssue {
  id             String          @id @default(uuid())
  creatorId      String
  creator        User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  subject        String // 1-150 chars, validated at the app layer
  body           String // sanitized markdown/HTML, same posture as every other user-authored content field since Phase 1 §7.2
  requiredTierId String? // spec §10.1: paid-only issues, reuses §4.2's gate
  requiredTier   MembershipTier? @relation(fields: [requiredTierId], references: [id], onDelete: SetNull)
  status         String          @default("draft") // draft | scheduled | sent
  sentAt         DateTime?
  createdAt      DateTime        @default(now())

  @@index([creatorId, status])
}

// phase-5 spec §7.1: the affiliate must be a 0dot user who completes the
// *same* CreatorPayoutAccount onboarding from §3 — no separate payout rail.
// offeringType/offeringId is a polymorphic pointer (membership_tier |
// digital_product | course) rather than three nullable FKs, matching this
// schema's own precedent for a small closed set of target types where a
// typed FK per type would just be three always-two-null columns.
model AffiliateProgram {
  id                String   @id @default(uuid())
  creatorId         String
  creator           User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  offeringType      String // membership_tier | digital_product | course
  offeringId        String
  commissionPercent Float
  status            String   @default("active") // active | paused
  createdAt         DateTime @default(now())

  links AffiliateLink[]

  @@index([creatorId])
  @@index([offeringType, offeringId])
}

model AffiliateLink {
  id          String           @id @default(uuid())
  programId   String
  program     AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  affiliateId String
  affiliate   User             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  code        String           @unique
  createdAt   DateTime         @default(now())

  clicks      AffiliateClick[]
  conversions AffiliateConversion[]

  @@index([programId])
  @@index([affiliateId])
}

// spec §7.2/§13.1: referrerHost only, same no-raw-IP/UA posture as Phase
// 1's LinkClick — src/app/aff/[code]/route.ts is the one write path.
model AffiliateClick {
  id              String        @id @default(uuid())
  affiliateLinkId String
  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  occurredAt      DateTime      @default(now())
  referrerHost    String?

  @@index([affiliateLinkId, occurredAt])
}

// spec §7.3: only ever created alongside a successful PaymentTransaction
// (paymentTransactionId unique — one conversion per sale, never a second
// row for the same charge), reusing the ledger rather than a separate
// payout table, same "every money-moving feature writes exactly one
// PaymentTransaction row" rule §3.1 establishes for every other kind.
model AffiliateConversion {
  id                   String             @id @default(uuid())
  affiliateLinkId      String
  affiliateLink        AffiliateLink      @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  paymentTransactionId String             @unique
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  commissionAmount     Float
  createdAt            DateTime           @default(now())

  @@index([affiliateLinkId])
}

// phase-5 spec §8.2 (MVP: single-host broadcast, no VOD by default).
// ingestKey/playbackUrl come from LivestreamProvider (src/lib/
// livestream-provider.ts) — a processor-agnostic interface with a stub
// implementation, same delegation pattern payments.ts already established
// for CreatorPayoutAccount: this build has no real video ingest/
// transcoding/CDN behind it (spec §8.1 flags that as a substantially
// larger infra lift than anything else in this phase), so playbackUrl is
// an opaque stub value, not a real streamable URL. What's real here is the
// access-control layer around it (§8.3's three acceptance criteria), which
// doesn't change shape when a real provider is swapped in later.
model Livestream {
  id             String          @id @default(uuid())
  creatorId      String
  creator        User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title          String // 1-120 chars, validated at the app layer
  status         String          @default("scheduled") // scheduled | live | ended
  scheduledAt    DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  requiredTierId String? // spec §8.2: reuses §4.2's gate for paid livestreams
  requiredTier   MembershipTier? @relation(fields: [requiredTierId], references: [id], onDelete: SetNull)
  ingestKey      String // opaque, infra-managed — never exposed in a viewer-facing response (§13.1)
  playbackUrl    String
  createdAt      DateTime        @default(now())

  // phase-8 spec §6.2: scopes a livestream to an event, same additive-column
  // idiom as Post.communityId — the event is a *context*, not a competing
  // owner (creatorId already names the one meaningful owner: whoever's
  // broadcasting). "At most one native session per event" (§6.4) is an
  // app-layer constraint (attachLivestreamToEvent, events.ts), not a DB
  // unique here, since a future stream can reattach after an earlier one
  // ends.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // phase-8 spec §6.3: resolves the Phase 5 §8.2 VOD deferral. isRecorded
  // must be surfaced as a visible disclosure before/at session start at the
  // UI layer (§6.4's acceptance criterion) — this schema only stores the
  // fact, it doesn't enforce the disclosure UX.
  isRecorded             Boolean @default(false)
  recordingUrl           String?
  recordingRetentionDays Int?

  chatMessages LivestreamChatMessage[]

  @@index([creatorId, status])
  @@index([requiredTierId])
  @@index([eventId])
}

// Structurally identical to Phase 3's CommunityChatMessage (§11.1 of that
// spec) — a second instance of the same "broadcast chat, no per-user read
// state" shape, spec §8.2's own comment on this. Two instances doesn't yet
// justify extracting a shared table (the standing "three similar things
// before you generalize" guidance), noted for if a third shows up.
model LivestreamChatMessage {
  id           String     @id @default(uuid())
  livestreamId String
  livestream   Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body         String // 1-500 chars, validated at the app layer
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  @@index([livestreamId, createdAt])
}

// phase-6 spec §3.1, build plan step 1: the anchor entity for the whole
// phase — everything else in Phase 6 optionally attaches to a Project, but
// Project itself only depends on User. Deliberately NOT another Post scope
// (see spec §9's full reasoning: a Project is a single subject people react
// to, like Business, not a space people post into — that's what earns it
// its own ProjectLike/ProjectComment below instead of a fifth
// Post.<x>_id column). No citext (SQLite, see Community.slug/Business.slug)
// — lowercased at write time, same as every other slug namespace; this is
// the fourth reuse of validateSlugFormat (usernames, communities,
// businesses, now projects — src/lib/reserved-project-slugs.ts).
// galleryJson/externalLinksJson follow BusinessLocation.hoursJson's exact
// "JSON text column, not jsonb[]" reasoning — SQLite has no array/jsonb
// type. status/visibility are plain strings per this schema's existing
// string-enum convention (see User.status), not Prisma enum blocks (this
// schema doesn't use any).
model Project {
  id                String    @id @default(uuid())
  slug              String    @unique
  ownerId           String
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  summary           String    @default("") // 0-280 chars, shown on cards and in search results
  description       String    @default("") // sanitized markdown, same posture as every other long-form field since phase-1 §7.2
  coverImageUrl     String?
  galleryJson       String? // JSON array of up to 12 {url, ...} media entries; null/empty = none
  status            String    @default("in_progress") // in_progress | completed | archived
  startedAt         DateTime?
  completedAt       DateTime?
  externalLinksJson String? // JSON array of {label, url}; each url validated by isSafeUrl at write time (no javascript:/data:)
  visibility        String    @default("public") // public | unlisted — see spec §3.3: unlisted is obscurity, not access control
  featuredOnResume  Boolean   @default(false)
  likeCount         Int       @default(0)
  commentCount      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  collaborators   ProjectCollaborator[]
  likes           ProjectLike[]
  comments        ProjectComment[]
  skills          ProjectSkill[]
  gitRepositories GitRepository[]
  researchPapers  ResearchPaper[]

  @@index([ownerId])
  @@index([visibility, createdAt])
}

// spec §3.1: userId is nullable so a collaborator without a 0dot account can
// still be credited by display_name alone — enforced at the app layer
// (addCollaborator requires displayName when userId is absent), not a DB
// CHECK constraint, same "app-layer invariant, not a schema constraint"
// posture as Follow's followerId != followeeId. The spec's partial unique
// index on (project_id, user_id) WHERE user_id IS NOT NULL has no Prisma
// schema representation without a native database extension this codebase
// doesn't use elsewhere — duplicate-credit prevention for a registered user
// is enforced the same app-layer way in addCollaborator instead.
model ProjectCollaborator {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName String?
  role        String?
  createdAt   DateTime @default(now())

  @@index([projectId])
}

// phase-6 spec §9: mirrors PostLike exactly (composite PK, no separate id).
model ProjectLike {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
}

// phase-6 spec §9: flat comments only, no reply_to_id-equivalent — same
// simplification phase-1 §5.3 already applied to the general feed. Soft-
// deleted (deletedAt), never hard-deleted, same posture as Post.
model ProjectComment {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String // 1-1000 chars, validated at the app layer
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([projectId, createdAt])
}

// phase-6 spec §4.1, build plan step 3. name is free text (not a fixed
// taxonomy — skill vocabulary is too broad to curate exhaustively, unlike
// phase-4's business categories), normalized (trimmed, case-folded) at the
// app layer for near-duplicate comparison only, not a DB constraint —
// same "app-layer invariant, not schema constraint" posture used
// throughout this schema. position follows Link.position's manual
// drag-and-drop-equivalent (up/down swap, see moveLink) ordering
// convention.
model Skill {
  id               String  @id @default(uuid())
  profileId        String
  profile          Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name             String
  position         Int
  endorsementCount Int     @default(0)

  endorsements SkillEndorsement[]
  projects     ProjectSkill[]

  @@index([profileId])
}

// spec §4.1/§4.2: any logged-in user may endorse any skill once, no
// relationship gating — same open default phase-2 following already uses.
// Composite PK makes a repeat endorsement a no-op at the DB level (the
// idempotency the spec's acceptance criterion asks for), same shape as
// PollVote/ProjectLike.
model SkillEndorsement {
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endorserId String
  endorser   User     @relation(fields: [endorserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([skillId, endorserId])
}

// spec §3.1: a Project may credit the Skills it used — pure join table,
// no attributes of its own.
model ProjectSkill {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

// phase-6 spec §6.1, build plan step 4. position is a manual override;
// the default reverse-chronological-by-start_date ordering (spec §6.1's
// literal wording) is computed at the read path, not stored — same
// "position overrides a computed default" shape Link.position uses
// relative to createdAt elsewhere, kept consistent rather than inventing a
// second convention for the same idea.
model WorkExperience {
  id          String    @id @default(uuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime? // null = current position
  description String    @default("")
  position    Int

  @@index([profileId])
}

model Education {
  id           String    @id @default(uuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  description  String    @default("")
  position     Int

  @@index([profileId])
}

// phase-6 spec §5.1/§5.3, build plan step 5. Public repository URLs only —
// no OAuth token or credential of any kind is stored here, a deliberate
// scope boundary (§5.3), not an oversight: linking a private repo would
// need per-user stored provider credentials, a real security-surface
// increase this phase doesn't need to justify. provider follows this
// schema's plain-string-enum convention. starCount/description/
// primaryLanguage/lastSyncedAt are refreshed by src/lib/portfolio-sync.ts
// on a background schedule (§5.2) — never fetched live on a profile view.
model GitRepository {
  id              String    @id @default(uuid())
  profileId       String
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  provider        String // github | gitlab | bitbucket | other
  url             String
  displayName     String
  description     String?
  primaryLanguage String?
  starCount       Int?
  lastSyncedAt    DateTime?

  @@index([profileId])
  @@index([projectId])
}

// phase-6 spec §7: research papers, certificates, and awards are all
// self-attested, never verified against a third-party issuer API (§7.4) —
// an explicit, named trust boundary (same posture Phase 5 gave podcast
// RSS gating, §9.2 of that spec), not a silent gap. None of the three
// exposes verified-style UI (no reuse of the isVerified checkmark
// treatment used elsewhere) — only a self-reported credential with an
// optional external link the viewer can check themselves (§7.5).

model ResearchPaper {
  id          String    @id @default(uuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  authors     String // free text (e.g. "A. Smith, B. Jones") — not linked Users, co-authors are frequently not 0dot members
  venue       String?
  publishDate DateTime?
  doiOrUrl    String?
  fileUrl     String? // optional uploaded PDF, same direct-filesystem-write pattern as resumePdfUrl
  abstract    String    @default("")

  @@index([profileId])
}

model Certificate {
  id            String    @id @default(uuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  issuingOrg    String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String? // external verification link the viewer can independently check, e.g. a Credly badge page
  badgeImageUrl String?

  @@index([profileId])
}

model Award {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  issuingOrg  String?
  awardedDate DateTime
  description String   @default("")
  link        String?

  @@index([profileId])
}

// phase-7 spec §3, build plan step 1: article/tutorial/note share one table
// (format is data, not schema — spec §3.1). Slug is scoped to the author,
// not global (unlike Project's flat @unique slug) — same @@unique([ownerId,
// slug]) shape WikiPage already established relative to Community
// (communityId, slug), substituting authorId here since there's no
// community-equivalent owner. body reuses renderWikiMarkdown (the same
// "sanitized markdown" render-time-only posture as Project.description,
// phase-1 spec §7.2) rather than a new sanitizer.
model Article {
  id                 String    @id @default(uuid())
  authorId           String
  author             User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  slug               String
  title              String
  subtitle           String?
  format             String    @default("article") // article | tutorial | note — spec §3.1
  body               String    @default("")
  coverImageUrl      String?
  status             String    @default("draft") // draft | published
  // spec §3.2: the first REAL private tier in this schema — server-enforced,
  // author-only, not the obscurity-only "unlisted" Project/podcast pattern.
  // See src/app/actions/articles.ts / [username]/articles/[slug]/page.tsx
  // for the read-path gate, modeled on Community.visibility's existing
  // `visibility !== "private" || <authorized>` precedent.
  visibility         String    @default("public") // public | unlisted | private
  readingTimeMinutes Int       @default(0) // computed from word count at publish time, cached
  likeCount          Int       @default(0)
  commentCount       Int       @default(0)
  viewCount          Int       @default(0)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  hashtags ArticleHashtag[]

  @@unique([authorId, slug])
  @@index([visibility, status, publishedAt])
}

// phase-7 spec §3.1: the first persisted hashtag structure in this
// codebase — Post's #tags (src/lib/linkify.tsx) are render-time-only regex
// styling, never written to a table. Article tags are author-supplied
// structured input, not parsed from inline body text the way Post's are, so
// there's no existing extraction path to reuse; this is a fresh, minimal
// table rather than an extension of linkify.tsx. name is lowercased/trimmed
// at the app layer for the same near-duplicate reasoning Skill.name uses.
model Hashtag {
  id   String @id @default(uuid())
  name String @unique

  articles ArticleHashtag[]
}

// Pure join, no attributes of its own — same shape as ProjectSkill.
// syncArticleHashtags (articles.ts) replaces-all-on-save, same pattern
// syncProjectSkills already established for ProjectSkill.
model ArticleHashtag {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([articleId, hashtagId])
}

// phase-7 spec §4: the generalized like/comment primitive — Article is the
// third-plus instance of the "single subject people react to" pattern
// (after Business.Review, Project's ProjectLike/ProjectComment), the
// spec-named threshold to stop growing a new bespoke pair per phase (§4.1).
// subjectType/subjectId is a deliberate polymorphic pair, not a real FK —
// there's no single table to point a foreign key at across article/
// wiki_page/book/published_file, so referential integrity (e.g. cleaning up
// a deleted article's reactions) is enforced at the app layer in
// deleteArticle, not via onDelete: Cascade. Only subjectType = "article" has
// a producer this session (build plan step 2); wiki_page/book/
// published_file are added in later phase-7 steps per spec §12 without any
// schema change here. Business.Review and ProjectLike/ProjectComment are
// deliberately NOT retrofitted onto this table (spec §4.3) — untouched by
// this migration.
model Reaction {
  id          String   @id @default(uuid())
  subjectType String // article | wiki_page | book | published_file
  subjectId   String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String   @default("like") // like — deliberately one kind, not an overbuilt reaction palette (spec §4)
  createdAt   DateTime @default(now())

  @@unique([subjectType, subjectId, userId])
  @@index([subjectType, subjectId])
}

// Flat, single-level comments, soft-deleted — same simplification already
// applied to ProjectComment and Post's one-level reply threading (spec §4.1).
model Comment {
  id          String    @id @default(uuid())
  subjectType String
  subjectId   String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String // 1-1000 chars, validated at the app layer
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([subjectType, subjectId, createdAt])
}

// phase-7 spec §6.1, build plan step 6. profileId (not authorId/userId) —
// unlike Article, the spec's own field list writes this as `fk -> Profile`
// (§6.1 line 258), matching the ResearchPaper/Certificate/Award/Skill
// convention of profile-scoped entities, not Article's `authorId -> User`
// shape (Article mirrors WikiPage's communityId precedent instead — see
// that model's comment). likeCount/commentCount are real cached columns
// here (spec lists them explicitly for Book, unlike WikiPage/PublishedFile,
// which don't get denormalized counters this phase — their like/comment
// counts are computed at read time via Reaction/Comment queries instead).
model Book {
  id            String   @id @default(uuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  description   String   @default("")
  coverImageUrl String?
  status        String   @default("draft") // draft | published
  visibility    String   @default("public") // public | unlisted | private
  // spec §6.2: optional full-book download (epub/pdf) — an author can skip
  // native chapters entirely and just upload a finished file, or do both.
  ebookFileUrl  String?
  likeCount     Int      @default(0)
  commentCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Chapters are WikiPage rows with bookId set and kind = "book_chapter"
  // (spec §6.1) — not a separate chapter entity, reusing the
  // parentPageId/position hierarchy already built for documentation.
  chapters WikiPage[]

  @@unique([profileId, slug])
  @@index([visibility, status])
}

// phase-7 spec §7.1, build plan step 8. Unlike Book's single ebookFileUrl,
// this needs visibility-DEPENDENT delivery (spec §7.2): a public file is
// servable from a stable permanent URL with zero per-request check, so
// fileUrl is only ever set for public files (a plain /uploads/... path via
// saveDocumentFile, same as ResearchPaper.fileUrl). A private/unlisted file
// instead gets fileKey/fileMimeType — an internal src/lib/protected-storage
// key, never rendered directly, only ever resolved to a short-lived signed
// download URL after a request-time authorization check (mirrors the
// existing DigitalProduct.fileKey/fileMimeType pair and the same
// issueDownloadToken/verifyDownloadToken mechanism Phase 5 built for gated
// digital-product/lesson/podcast-episode downloads — extended with a fourth
// resourceType rather than building a second gated-delivery pipeline). No
// likeCount/commentCount columns (see Reaction/Comment's schema comment) —
// spec §7.1's own field list doesn't include them the way Article/Book's
// do, so counts are computed at read time instead of cached.
model PublishedFile {
  id            String    @id @default(uuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  description   String    @default("")
  coverImageUrl String?
  fileUrl       String? // set only when visibility = public
  fileKey       String? // set only when visibility = private/unlisted (protected-storage key)
  fileMimeType  String?
  fileSizeBytes Int
  visibility    String    @default("public") // public | unlisted | private
  downloadCount Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  downloads PublishedFileDownload[]

  @@unique([profileId, slug])
  @@index([visibility, publishedAt])
}

// spec §7.1: no raw IP/user-agent, same no-raw-IP/UA posture every other
// click/analytics event in this system follows since Phase 1 §4.3.
model PublishedFileDownload {
  id           String        @id @default(uuid())
  fileId       String
  file         PublishedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  occurredAt   DateTime      @default(now())
  referrerHost String?

  @@index([fileId, occurredAt])
}

// phase-8 spec §3.1, build plan step 1: the anchor entity for the whole
// phase. Third instance of the three-way nullable-owner-column-set idiom in
// this schema, after WikiPage (Phase 7 §5.1) — which the spec itself names
// as precedent (§3.2) — real per-type FKs with an enforced exactly-one
// constraint, checked at the app layer (createEvent/updateEvent, events.ts),
// not a generic polymorphic owner_type/owner_id pair. createdBy is kept
// distinct from the host columns for audit (spec's own field comment), and
// doubles as the one resolvable "owner" the Reaction/Comment subject
// resolver needs (build plan §4) regardless of which host type is set. No
// citext (SQLite, see Community.slug) — lowercased at write time, sixth
// reuse of validateSlugFormat (usernames, communities, businesses, projects,
// articles, now events) via reserved-event-slugs.ts. Global slug namespace
// (@@unique, not owner-scoped) — 0dot.in/e/slug is a flat namespace like
// /c/, /b/, /p/, not a per-owner path.
model Event {
  id                     String     @id @default(uuid())
  slug                   String     @unique
  hostedByUserId         String?
  hostedByUser           User?      @relation("EventHostedByUser", fields: [hostedByUserId], references: [id], onDelete: Cascade)
  hostedByBusinessId     String?
  hostedByBusiness       Business?  @relation("EventHostedByBusiness", fields: [hostedByBusinessId], references: [id], onDelete: Cascade)
  hostedByCommunityId    String?
  hostedByCommunity      Community? @relation("EventHostedByCommunity", fields: [hostedByCommunityId], references: [id], onDelete: Cascade)
  createdBy              String
  creator                User       @relation("EventCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  title                  String
  description            String     @default("") // sanitized markdown, standard posture since Phase 1 §7.2
  coverImageUrl          String?
  format                 String // in_person | virtual | hybrid
  location               String? // required if format != virtual, enforced at the app layer
  // phase-16 spec §10.1: closes the asymmetry with BusinessLocation's real
  // lat/lng — a map can't plot an event with location as free text only.
  // Nullable/optional on every event, same additive-column posture as
  // Community.restrictedToOrganizationId.
  latitude               Float?
  longitude              Float?
  virtualJoinUrl         String? // external meeting link — independent of native livestream/voice-room attachment (§6.1)
  startsAt               DateTime
  endsAt                 DateTime?
  timezone               String // IANA name, stored explicitly — same reasoning as AvailabilityRule (Phase 4 §10.2)
  status                 String     @default("draft") // draft | published | cancelled
  capacity               Int? // hard cap on going RSVPs + non-cancelled tickets combined, no waitlist (§4.3)
  attendeeListVisibility String     @default("public") // public | attendees_only | host_only
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  rsvps       EventRSVP[]
  ticketTypes TicketType[]
  livestreams Livestream[]
  voiceRooms  VoiceRoom[]

  @@index([hostedByUserId])
  @@index([hostedByBusinessId])
  @@index([hostedByCommunityId])
  @@index([status, startsAt]) // search §9.1: upcoming listing, soonest-first tie-break
}

// spec §4.1. unique (eventId, userId) is the one-RSVP-per-user guarantee;
// a status change (going -> not_going, etc.) updates this row rather than
// creating a new one.
model EventRSVP {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String // going | interested | not_going
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId, status])
}

// spec §5.1. price/currency nullable together = a free tier, same
// nullable-price-means-free shape Offering/DigitalProduct already use.
// quantitySold is denormalized, incremented transactionally alongside every
// Ticket write — same pattern used throughout this schema.
model TicketType {
  id            String    @id @default(uuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  price         Float?
  currency      String?
  quantityTotal Int?
  quantitySold  Int       @default(0)
  salesStartAt  DateTime?
  salesEndAt    DateTime?
  createdAt     DateTime  @default(now())

  tickets Ticket[]

  @@index([eventId])
}

// spec §5.1. qrCodeToken is a genuine access-control credential (build plan
// §5) — crypto.randomBytes-generated, never derivable from ownerId/eventId/
// ticketTypeId, unlike Phase 1's profile QR code which just encodes a
// public URL and carries no access-control weight (§5.1's explicit
// distinction).
model Ticket {
  id                   String              @id @default(uuid())
  ticketTypeId         String
  ticketType           TicketType          @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  ownerId              String
  owner                User                @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  paymentTransactionId String?             @unique // null = a free ticket
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  status               String              @default("valid") // valid | cancelled | checked_in
  qrCodeToken          String              @unique
  checkedInAt          DateTime?
  createdAt            DateTime            @default(now())

  @@index([ownerId])
  @@index([ticketTypeId])
}

// phase-9 spec §4.3: the new entity for Themes/Templates/Apps — Courses and
// digital products are deliberately NOT modeled here (spec §5.1: reused
// as-is, this phase only adds a browse layer over them, see the search/page
// query-time union). seller_type/seller_user_id/seller_business_id is the
// same two-way owner XOR idiom as Offering/Link, communities excluded from
// selling here same as Phase 8 §5.2 excludes them from ticketing payout.
// payload is jsonb-equivalent (SQLite has no jsonb — a JSON text column,
// same BusinessLocation.hoursJson precedent) and is validated at write time
// per category (§4.6's literal acceptance criteria: theme payloads can't
// exceed Phase 1 §3.6's token schema, app payloads can't reference an
// embed source outside the provider allowlist) — never raw HTML/CSS/JS in
// any category, checked in createMarketplaceListing (marketplace.ts), not
// left to the review queue alone to catch.
model MarketplaceListing {
  id               String    @id @default(uuid())
  sellerType       String // user | business
  sellerUserId     String?
  seller           User?     @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  sellerBusinessId String?
  sellerBusiness   Business? @relation(fields: [sellerBusinessId], references: [id], onDelete: Cascade)
  category         String // theme | template | app
  title            String // 1-120 chars, validated at the app layer
  description      String    @default("") // sanitized markdown, standard posture since Phase 1 §7.2
  price            Float? // nullable = free
  currency         String? // required iff price is set, same convention as Offering
  status           String    @default("pending_review") // pending_review | active | rejected | archived
  payload          String // JSON text — category-specific structured content, see model comment
  averageRating    Float     @default(0)
  reviewCount      Int       @default(0)
  purchaseCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // phase-10 spec §8: null = a Phase 9 sandboxed widget, unaffected by this
  // column existing at all. Set = installing this listing goes through the
  // real OAuth authorization flow (see /m/install-callback) instead of just
  // writing an InstalledApp config blob.
  developerAppId String?
  developerApp   DeveloperApp? @relation(fields: [developerAppId], references: [id], onDelete: SetNull)

  purchases MarketplacePurchase[]
  installs  InstalledApp[]
  reviews   MarketplaceListingReview[]

  @@index([status, category])
  @@index([sellerUserId])
  @@index([sellerBusinessId])
  @@index([developerAppId])
}

// spec §4.3/§7.2: paymentTransactionId is nullable — a free listing (or a
// free install-gate for review eligibility) has no charge to point at,
// same nullable-payment shape CourseAccessGrant already uses for its
// membership_tier-bundled (non-purchase) grant path.
model MarketplacePurchase {
  id                   String              @id @default(uuid())
  listingId            String
  listing              MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId              String
  buyer                User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  paymentTransactionId String?             @unique
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  createdAt            DateTime            @default(now())

  @@unique([listingId, buyerId])
  @@index([buyerId])
}

// spec §4.3: a three-way installer XOR — wider than the seller XOR above
// because a widget can attach to a profile, a business page, or a
// community, all three of which are real installation surfaces (unlike
// selling, where communities are deliberately excluded). installerUserId
// points at Profile, not User — see Profile.installedApps's comment for
// why. config is validated against the listing's own declared payload
// schema at install time (installApp, marketplace.ts), not the DB.
model InstalledApp {
  id                   String             @id @default(uuid())
  listingId            String
  listing              MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  installerType        String // user | business | community
  installerUserId      String?
  installerProfile     Profile?           @relation(fields: [installerUserId], references: [id], onDelete: Cascade)
  installerBusinessId  String?
  installerBusiness    Business?          @relation(fields: [installerBusinessId], references: [id], onDelete: Cascade)
  installerCommunityId String?
  installerCommunity   Community?         @relation(fields: [installerCommunityId], references: [id], onDelete: Cascade)
  config               String? // JSON text — installer-specific settings within the app's declared schema
  installedAt          DateTime           @default(now())

  @@index([listingId])
  @@index([installerUserId])
  @@index([installerBusinessId])
  @@index([installerCommunityId])
  // Uniqueness against duplicate installs (installApp's read-then-write
  // race, closed in migration 20260818150500_installed_app_idempotency) is
  // enforced by three raw partial unique indexes on
  // (listingId, installerUserId/installerBusinessId/installerCommunityId)
  // — not expressible as a declarative `@@unique` here since Prisma has no
  // partial/filtered-index syntax, and a plain compound unique across all
  // three nullable columns wouldn't catch it (NULL isn't unique-equal to
  // NULL in SQLite). This comment is the only trace of them in this file —
  // `prisma migrate diff`/`db push` won't see them and won't try to drop
  // them, but also won't recreate them if the DB is ever rebuilt from this
  // schema alone rather than replayed through prisma/migrations/.
}

// phase-9 spec §7.1: the second instance of the rated-review pattern after
// Business's Review/ReviewResponse (Phase 4 §11) — per this codebase's
// "three instances before generalizing" discipline (spec's own citation of
// Phase 6 §9/Phase 7 §4.1), not yet generalized into Reaction/Comment or a
// subject-type table. One review per (listingId, authorId), same
// "editable, not stackable" upsert shape as Review. Unlike Review,
// verified-purchase gating is enforced at write time (createOrUpdate
// ListingReview, marketplace.ts) per spec §7.2 — cheap to check here since
// each listing is an individually purchased/installed thing, unlike a
// business as a whole.
model MarketplaceListingReview {
  id        String             @id @default(uuid())
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  body      String             @default("")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  response MarketplaceListingReviewResponse?

  @@unique([listingId, authorId])
  @@index([listingId])
}

// One official response per review — same shape as ReviewResponse
// (reviewId as the model's own @id enforces the one-response rule).
// responderId must be the individual seller, or admin+ business staff,
// checked in respondToListingReview (marketplace.ts), not the schema.
model MarketplaceListingReviewResponse {
  reviewId    String                   @id
  review      MarketplaceListingReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  responderId String
  responder   User                     @relation(fields: [responderId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime                 @default(now())
}

// phase-10 spec §3.1: two-way owner XOR, same idiom as Offering/
// MarketplaceListing's seller side — communities don't build apps, so
// that third owner kind is excluded here unlike InstalledApp's installer
// side. clientSecretHash follows User.passwordHash's exact posture: hashed
// at rest, the raw value shown exactly once at creation (createDeveloperApp,
// developer-apps.ts) and never retrievable again, not even to this app's
// own dashboard (spec §3.2).
model DeveloperApp {
  id                String    @id @default(uuid())
  ownerType         String // user | business
  ownerUserId       String?
  ownerUser         User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerBusinessId   String?
  ownerBusiness     Business? @relation(fields: [ownerBusinessId], references: [id], onDelete: Cascade)
  name              String
  description       String    @default("")
  clientId          String    @unique
  clientSecretHash  String
  // phase-15 build plan step 3: RFC 8252 public-client posture — a client
  // that ships inside a distributed app binary (first-party iOS/Android/
  // desktop, spec §3.2) cannot hold clientSecretHash's plaintext secret
  // safely no matter how it's embedded, so the token endpoint must accept
  // PKCE's code_verifier alone as proof of possession for these apps
  // instead of also demanding a secret. Default false changes nothing for
  // every existing third-party app, which still authenticates the way it
  // always has.
  isPublicClient    Boolean   @default(false)
  redirectUrisJson  String // JSON array of exact-match redirect URIs (spec §3.2: no wildcard/prefix matching)
  status            String    @default("active") // active | suspended
  // billing addendum §4.1: metered against the existing ApiUsageCounter
  // rows below, kept separate from PlatformSubscription since the billing
  // model genuinely differs (usage-metered vs. flat recurring). free stays
  // exactly as api-rate-limit.ts's pre-existing hard cap behaved (§4.2's
  // acceptance criterion); pay_as_you_go/committed apps aren't hard-capped,
  // they're billed instead (api-usage-billing.ts).
  billingPlan       String    @default("free") // free | pay_as_you_go | committed
  lastBilledAt      DateTime? // watermark for api-usage-billing.ts's periodic settlement sweep
  // Set once billingPlan moves off "free" via a real Stripe subscription
  // Checkout (api-usage-billing.ts) — null on "free" apps, and briefly null
  // on a paid app mid-checkout before the webhook confirms it.
  apiSubscriptionId String?
  createdAt         DateTime  @default(now())

  scopes               DeveloperAppScope[]
  authorizationCodes   OAuthAuthorizationCode[]
  authorizations       OAuthAuthorization[]
  webhookSubscriptions WebhookSubscription[]
  usageCounters        ApiUsageCounter[]
  marketplaceListings  MarketplaceListing[]

  @@index([ownerUserId])
  @@index([ownerBusinessId])
}

// Fixed, curated catalog (spec §4.1) — rows are seeded (OAUTH_SCOPES in
// oauth.ts), never user-created, same "fixed allowlist, widened by adding
// an entry in code" posture as marketplace.ts's EMBED_PROVIDERS.
model OAuthScope {
  key         String @id // e.g. "profile:read", "messages:read"
  description String
  sensitivity String // low | medium | high

  appScopes DeveloperAppScope[]
}

// spec §4.1: scopes a DeveloperApp is registered/approved to request.
// low/medium sensitivity scopes are auto-approved at request time;
// high-sensitivity scopes sit at status "pending" until an admin approves
// them (spec §4.3) — requestDeveloperAppScope/approveDeveloperAppScope in
// oauth.ts, same review-gate shape as MarketplaceListing's pending_review.
model DeveloperAppScope {
  appId       String
  app         DeveloperApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  scopeKey    String
  scope       OAuthScope   @relation(fields: [scopeKey], references: [key], onDelete: Cascade)
  status      String       @default("pending") // pending | approved | rejected
  requestedAt DateTime     @default(now())
  reviewedAt  DateTime?

  @@id([appId, scopeKey])
}

// Short-lived row bridging the redirect (authorize) and token-exchange
// steps of the authorization-code flow — the spec's §4.2 data model starts
// at OAuthAuthorization, but a persisted code is required between those two
// requests (this can't be a server session, since the request lands back
// on the third-party app's own server). One-time use via usedAt, same
// "opaque token row, checked and consumed" shape as PodcastFeedToken.
model OAuthAuthorizationCode {
  code                String       @id
  appId               String
  app                 DeveloperApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String
  scopesJson          String // JSON array of scope keys the user approved at the consent screen
  codeChallenge       String
  codeChallengeMethod String // S256 | plain
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime     @default(now())

  @@index([appId])
}

model OAuthAuthorization {
  id                String       @id @default(uuid())
  appId             String
  app               DeveloperApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedScopesJson String // JSON array of scope keys
  status            String       @default("active") // active | revoked
  createdAt         DateTime     @default(now())
  revokedAt         DateTime?

  tokens OAuthToken[]

  @@unique([appId, userId])
  @@index([userId])
}

// accessTokenHash/refreshTokenHash follow clientSecretHash's exact posture
// (spec §4.2, §12.1) — a leaked DB must not yield usable bearer tokens.
// Revoking the parent OAuthAuthorization (revokeOAuthAuthorization,
// oauth.ts) deletes every row here via cascade, satisfying spec §4.4's
// "revocation immediately invalidates already-issued tokens" criterion
// without a separate revocation check needed on every API request.
model OAuthToken {
  id               String             @id @default(uuid())
  authorizationId  String
  authorization    OAuthAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  accessTokenHash  String             @unique
  refreshTokenHash String?            @unique
  expiresAt        DateTime
  createdAt        DateTime           @default(now())

  @@index([authorizationId])
}

// spec §7.1: event_types drawn from the existing Notification.type/
// subjectType catalog, not a second vocabulary. secret is HMAC-signing,
// shown once at creation like clientSecretHash, but kept in plaintext here
// (not hashed) since, unlike a bearer credential, it must be re-read on
// every delivery to compute the signature — same trade-off as would apply
// to any HMAC secret, not a departure from this schema's hashing posture
// for actual credentials.
model WebhookSubscription {
  id             String       @id @default(uuid())
  appId          String
  app            DeveloperApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  eventTypesJson String // JSON array of Notification.type values
  targetUrl      String // must be https, checked in createWebhookSubscription
  secret         String
  status         String       @default("active") // active | disabled
  failureCount   Int          @default(0)
  createdAt      DateTime     @default(now())

  deliveries WebhookDelivery[]

  @@index([appId])
}

model WebhookDelivery {
  id              String              @id @default(uuid())
  subscriptionId  String
  subscription    WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType       String
  payload         String // JSON text
  status          String              @default("pending") // pending | delivered | failed
  attemptCount    Int                 @default(0)
  lastAttemptedAt DateTime?
  nextRetryAt     DateTime?
  createdAt       DateTime            @default(now())

  @@index([subscriptionId, status])
}

// spec §5.3: aggregated rolling-window counters, not a per-request log —
// windowStart is truncated to the top of the hour; one row per app per
// hour, incremented in place (checkApiRateLimit, api-rate-limit.ts).
model ApiUsageCounter {
  id           String       @id @default(uuid())
  appId        String
  app          DeveloperApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  windowStart  DateTime
  requestCount Int          @default(0)

  @@unique([appId, windowStart])
}

// phase-11 spec §3: shared AI usage audit substrate, deliberately
// generalized starting with the very first feature rather than waiting for
// three real instances (§3.1's stated exception to this series' usual
// "wait for three" discipline — Reaction/Comment in phase-7 §4.1, the
// explicit non-retrofit of Review in phase-9 §7.1). Every AI-touching model
// below (ModerationFlag, ContentTranslation, MediaAccessibilityMetadata)
// links back here instead of keeping its own bespoke log.
// requestedById is nullable for system-initiated generations (e.g. async
// moderation classification of newly-created content with no user actively
// waiting on it). inputSummary/outputSummary are bounded JSON text, not a
// verbatim prompt dump — see §3.2 and pruneExpiredPrivateAIGenerations in
// ai-generation.ts for the private-subject retention window this
// acceptance criterion requires.
model AIGeneration {
  id            String   @id @default(uuid())
  feature       String // profile_builder | content_writer | moderation | recommendation | search_rerank | translation | accessibility_caption
  requestedById String?
  requestedBy   User?    @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  subjectType   String?
  subjectId     String?
  modelName     String
  inputSummary  String // bounded/redacted JSON text — see §3.2
  outputSummary String // bounded/redacted JSON text
  accepted      Boolean? // null while pending; did a human accept/use/uphold the output
  costTokens    Int?
  createdAt     DateTime @default(now())

  moderationFlags       ModerationFlag[]
  translations          ContentTranslation[]
  accessibilityMetadata MediaAccessibilityMetadata[]
  trustSafetyCases      TrustSafetyCase[]
  accountRiskSignals    AccountRiskSignal[]

  @@index([subjectType, subjectId])
  @@index([requestedById])
}

// phase-11 spec §4.1: assistive by design, not by accident — four prior
// phases (phase-3 community moderation, phase-4 §3.3 business-claim gate,
// phase-9 §4.5 marketplace listing review, phase-10 §4.3 sensitive-scope
// review) each reserved room for exactly this feature on the explicit
// condition that automated screening supplements human review, never
// replaces it. suggestedAction deliberately has no auto-remove value for
// any risk_category here — every row ends at a human reviewedBy decision
// (upheld | overridden), recorded the same way phase-3's ModAction (§13)
// records community moderator decisions. The one exception (CSAM
// hash-matching, §4.2) is NOT modeled as a risk_category value here — see
// ai-moderation.ts's explicit note on why that pipeline is a wholly
// separate, legally-reviewed system.
model ModerationFlag {
  id              String       @id @default(uuid())
  subjectType     String // post | article | comment | marketplace_listing | business | ...
  subjectId       String
  aiGenerationId  String
  aiGeneration    AIGeneration @relation(fields: [aiGenerationId], references: [id], onDelete: Cascade)
  riskCategory    String // spam | harassment | violence | ip_infringement | fraud | other — illustrative, needs real policy/legal taxonomy
  confidence      Float // 0.0-1.0
  suggestedAction String // none | flag_for_review | escalate_urgent
  status          String       @default("pending_human_review") // pending_human_review | upheld | overridden
  reviewedById    String?
  reviewedBy      User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([subjectType, subjectId])
  @@index([status, createdAt])
}

// phase-11 spec §6.1: the file-attachment shape phase-7 §7.3 named
// (BusinessDocument, DigitalProduct.files, several phase-6 file_url
// columns) and explicitly declined to consolidate, since the duplication
// was low-cost scalar URL columns with no shared logic. AI accessibility
// metadata is the first real *logic* needing uniform attachment across
// every file-bearing field, which tips that cost/benefit call — but only
// for new uploads (§6.2): existing file columns are NOT retroactively
// migrated onto this table, same non-retrofit discipline phase-9 §7.1
// applied to Review/ProjectComment.
model FileAsset {
  id           String   @id @default(uuid())
  url          String
  contentType  String // image | video | audio | document
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  // phase-13 spec §6.1: opt-in per upload. watermarkedUrl is generated
  // asynchronously (same "never computed synchronously during a request"
  // principle as MediaAccessibilityMetadata below) — the original url above
  // is never mutated, so an owner/verified purchaser keeps receiving the
  // clean original regardless of this flag.
  watermarkEnabled Boolean @default(false)
  watermarkedUrl   String?

  accessibilityMetadata MediaAccessibilityMetadata?

  @@index([uploadedById])
}

// phase-11 spec §6.1/§6.2: fileAssetId covers every new upload from this
// phase forward; the legacySubjectType/legacySubjectId/legacyFieldName
// triplet is the lighter-weight path for attaching accessibility metadata
// to pre-existing (pre-phase-11) file columns without migrating them onto
// FileAsset. Exactly one of the two addressing schemes is set per row.
// humanEdited guards against a later automated re-generation silently
// overwriting a human's correction (§6.4 acceptance criterion).
model MediaAccessibilityMetadata {
  id                String       @id @default(uuid())
  fileAssetId       String?      @unique
  fileAsset         FileAsset?   @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  legacySubjectType String?
  legacySubjectId   String?
  legacyFieldName   String?
  altText           String?
  captionVttUrl     String?
  transcript        String?
  aiGenerationId    String
  aiGeneration      AIGeneration @relation(fields: [aiGenerationId], references: [id], onDelete: Cascade)
  humanEdited       Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([legacySubjectType, legacySubjectId])
}

// phase-11 spec §9.1: on-demand and cached per exact source version, not
// precomputed for every piece of content at write time, given per-call
// inference cost (§10.1). sourceRevisionKey is a WikiRevision id for
// versioned content (phase-3/7) or the source's own updatedAt.toISOString()
// for non-versioned content (Post, Article) — reuses the existing revision
// system rather than inventing a second versioning concept. A translation
// carries no visibility field of its own; it inherits the source's tier
// exactly, checked through the source's own authorization function (see
// ai-translation.ts), never a separate check that could drift from it.
model ContentTranslation {
  id                String       @id @default(uuid())
  subjectType       String
  subjectId         String
  sourceRevisionKey String
  targetLanguage    String // IETF BCP47 tag
  translatedText    String
  aiGenerationId    String
  aiGeneration      AIGeneration @relation(fields: [aiGenerationId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@unique([subjectType, subjectId, sourceRevisionKey, targetLanguage])
}

// phase-12 spec §3.2: manually granted, no self-serve flow — same posture
// as User.isPlatformAdmin (phase-4) and Profile.isVerified. requireTrustSafetyStaff
// (auth-guards.ts) upserts an `admin`-role row for any isPlatformAdmin user
// on first use so the unified queue has a bootstrap path without a
// dedicated role-management UI this phase doesn't need to build.
model TrustSafetyStaffRole {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String // reviewer | senior_reviewer | admin — senior_reviewer+ required for appeal review (§4.2) and the CSAM-adjacent pipeline (§3.2)
}

// phase-12 spec §3.1: the unified case-management layer over five
// previously-scattered review gates (business claim, marketplace listing,
// OAuth sensitive scope, AI ModerationFlag, community escalation) plus the
// two new report-driven case types this phase adds — WITHOUT migrating or
// restructuring any of those five tables' own status fields, which remain
// each entity's actual source of truth (resolveTrustSafetyCase in
// trust-safety.ts updates them). subjectType/subjectId deliberately mirror
// ModerationFlag's loose string-pair addressing (phase-11) rather than a
// polymorphic FK, since the subject set spans a dozen+ unrelated tables.
model TrustSafetyCase {
  id                   String        @id @default(uuid())
  caseType             String // content_report | account_report | business_claim_review | marketplace_listing_review | oauth_scope_review | ai_moderation_flag | community_escalation | review_dispute
  subjectType          String
  subjectId            String
  reportedById         String? // null for system/AI-initiated or gate-driven cases — see model comment on Report
  reportedBy           User?         @relation("TrustSafetyCaseReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  linkedAiGenerationId String?
  linkedAiGeneration   AIGeneration? @relation(fields: [linkedAiGenerationId], references: [id], onDelete: SetNull)
  reason               String?
  status               String        @default("open") // open | in_review | resolved_upheld | resolved_dismissed | escalated
  assignedToId         String?
  assignedTo           User?         @relation("TrustSafetyCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolutionNotes      String?
  createdAt            DateTime      @default(now())
  resolvedAt           DateTime?

  reports            Report[]
  appeals            Appeal[]
  dmcaTakedownNotice DMCATakedownNotice?

  @@index([status, createdAt])
  @@index([subjectType, subjectId])
  @@index([caseType, status])
}

// phase-12 spec §4.1: the one generic report action every reportable
// subjectType uses, instead of a bespoke report flow per content type.
// Kept deliberately distinct from TrustSafetyCase — this is the immutable
// record of what the reporter actually submitted, preserved as-is even as
// the case gets updated during review, same "raw input separate from
// mutable working state" split phase-11 used between AIGeneration and
// ModerationFlag. reporterId is never exposed to a report's subject —
// enforced at the query/serialization layer (trust-safety.ts), not by
// omitting the column (staff still need to see it).
model Report {
  id          String          @id @default(uuid())
  reporterId  String
  reporter    User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  subjectType String
  subjectId   String
  category    String // spam | harassment | hate_speech | violence | sexual_content | ip_infringement | impersonation | fraud | other
  details     String          @default("") // 0-2000 chars, validated at the app layer
  caseId      String
  case        TrustSafetyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@index([subjectType, subjectId])
  @@index([reporterId])
}

// phase-12 spec §5.1: an appeal of a TrustSafetyCase resolution.
// reviewedBy differs from the original case's assignedTo whenever a
// qualifying second (senior_reviewer+) reviewer is available (§5.2) —
// enforced in reviewAppeal (trust-safety.ts), not at the schema level.
model Appeal {
  id             String          @id @default(uuid())
  originalCaseId String
  originalCase   TrustSafetyCase @relation(fields: [originalCaseId], references: [id], onDelete: Cascade)
  filedById      String
  filedBy        User            @relation("AppealFiledBy", fields: [filedById], references: [id], onDelete: Cascade)
  statement      String // 1-2000 chars, validated at the app layer
  status         String          @default("pending") // pending | upheld_original | overturned
  reviewedById   String?
  reviewedBy     User?           @relation("AppealReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())

  @@index([originalCaseId])
  @@index([status, createdAt])
}

// phase-12 spec §6.1: account/behavioral-level signal, distinct from
// phase-11's ModerationFlag (which classifies individual pieces of
// content). aiGenerationId reuses phase-11's audit substrate when
// ML-derived rather than a second, parallel audit log (§6.4).
model AccountRiskSignal {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalType     String // velocity_anomaly | duplicate_content | coordinated_behavior | device_fingerprint_cluster | other
  score          Float // 0.0-1.0
  aiGenerationId String?
  aiGeneration   AIGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)
  detectedAt     DateTime      @default(now())

  @@index([userId, detectedAt])
}

// phase-13 spec §3.2: generalized at exactly three instances (WikiRevision
// was the first) rather than a bespoke table per content type. Full
// snapshot per revision, not a diff, matching WikiRevision's own approach.
// subjectType/subjectId is a loose pair (like Report/TrustSafetyCase), not
// a real FK — the subject set spans two unrelated tables.
model ContentRevision {
  id           String   @id @default(uuid())
  subjectType  String // post | article
  subjectId    String
  bodySnapshot String
  editedBy     String
  editor       User     @relation(fields: [editedBy], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
}

// phase-13 spec §5.1: opt-in — all_rights_reserved is the default in the
// absence of any row here (standard copyright law already grants creators
// full rights), so this table only exists for creators declaring *more*
// permissive terms. subjectType is intentionally broad (post, article,
// project, marketplace listing, business content, ...).
model ContentLicense {
  subjectType String
  subjectId   String
  licenseType String // all_rights_reserved | cc_by | cc_by_sa | cc_by_nc | cc_by_nd | cc0 | custom
  customTerms String?
  declaredAt  DateTime @default(now())

  @@id([subjectType, subjectId])
}

// phase-13 spec §4.1: built on Phase 12's TrustSafetyCase, not a parallel
// case-management system. Both statutory attestation booleans correspond to
// specific 17 U.S.C. § 512 language — the exact wording shown to
// complainants is legal's to draft, not engineering's; these fields only
// record that the required attestation was made.
model DMCATakedownNotice {
  id                               String          @id @default(uuid())
  trustSafetyCaseId                String          @unique
  trustSafetyCase                  TrustSafetyCase @relation(fields: [trustSafetyCaseId], references: [id], onDelete: Cascade)
  complainantName                  String
  complainantContact               String
  copyrightedWorkDescription       String
  infringingContentSubjectType     String
  infringingContentSubjectId       String
  goodFaithStatementAccepted       Boolean
  accuracyPerjuryStatementAccepted Boolean
  signature                        String
  submittedAt                      DateTime        @default(now())
  status                           String          @default("received") // received | content_removed | invalid_rejected

  counterNotice DMCACounterNotice?

  @@index([infringingContentSubjectType, infringingContentSubjectId])
}

// phase-13 spec §4.1/§4.5: restorationEligibleAt is submittedAt + the
// jurisdiction's statutory waiting period (JurisdictionRule, §9) —
// enforced by the restoration scheduler in dmca.ts (same setInterval
// posture as trending.ts's scheduler), not left to manual staff
// follow-through.
model DMCACounterNotice {
  id                         String             @id @default(uuid())
  originalNoticeId           String             @unique
  originalNotice             DMCATakedownNotice @relation(fields: [originalNoticeId], references: [id], onDelete: Cascade)
  subjectUserId              String
  subjectUser                User               @relation(fields: [subjectUserId], references: [id], onDelete: Cascade)
  goodFaithStatementAccepted Boolean
  consentToJurisdiction      Boolean
  signature                  String
  submittedAt                DateTime           @default(now())
  restorationEligibleAt      DateTime
  status                     String             @default("received") // received | content_restored | notice_forwarded_awaiting_lawsuit

  @@index([status, restorationEligibleAt])
}

// phase-13 spec §7: a lightweight historical log, distinct from just
// trusting whatever an entity's current owner/author field says right now
// — not a full chain-of-title system with transfer-approval workflows
// (§7's open question on consent model is left to product/legal, §11).
model OwnershipTransfer {
  id            String   @id @default(uuid())
  subjectType   String
  subjectId     String
  fromUserId    String?
  fromUser      User?    @relation("OwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId      String
  toUser        User     @relation("OwnershipTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  transferredAt DateTime @default(now())
  reason        String?

  @@index([subjectType, subjectId])
}

// phase-13 spec §9.1: a fifth instance of "legally required behavior that
// varies by jurisdiction" (recording consent, minimum age, newsletter
// consent regime, now copyright notice regime) — the shared extension
// point going forward. Not required to be exhaustively populated at
// launch; this phase's own DMCA-vs-other-regimes lookup (dmca.ts) is the
// proving consumer (§9.2's acceptance criterion), not every existing
// jurisdiction-dependent feature retrofitted onto it.
model JurisdictionRule {
  id             String   @id @default(uuid())
  region         String // ISO country code or broader region grouping
  ruleType       String // recording_consent | minimum_age | newsletter_consent_regime | copyright_notice_regime | other
  // Stringified JSON, e.g. {"waitingPeriodDays": 10} — follows
  // BusinessLocation.hoursJson/Offering.imagesJson's exact "no native Json
  // scalar in this codebase's sqlite setup" convention rather than
  // introducing a new field-typing pattern for one table.
  parametersJson String
  updatedAt      DateTime @updatedAt

  @@unique([region, ruleType])
}

// phase-14 spec §2.1: a company's internal control plane over its own
// employees' 0dot presence — SSO, audit logs, internal communities.
// Deliberately a separate entity from Business (Phase 4's public-facing
// storefront/company-page concept), not merged into it, with only an
// optional link. domain/domainVerifiedAt gate SSO enforcement and any
// domain-based auto-matching (§2.2) — the same "capability requires a gate"
// pattern as Business's claim gate, Marketplace's listing review, and
// Phase 10's sensitive-scope review.
model Organization {
  id   String @id @default(uuid())
  name String

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  domain                  String?   @unique
  // Random token an admin publishes as a DNS TXT record
  // (`0dot-domain-verify=<token>`) under the claimed domain — checked by
  // verifyOrganizationDomain (organizations.ts) via a real DNS TXT lookup.
  // Exact mechanism was flagged as an implementation detail in the spec
  // (§9); DNS TXT was chosen since it needs no new upload/hosting surface.
  domainVerificationToken String?
  domainVerifiedAt        DateTime?

  plan      String   @default("standard") // standard | enterprise
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members               OrganizationMember[]
  ssoConnection         SSOConnection?
  auditLogs             OrganizationAuditLog[]
  restrictedCommunities Community[]

  // phase-16: Future Modules
  ownedForms           Form[]
  fundraisingCampaigns FundraisingCampaign[]

  // billing addendum §2: the enterprise plan's subscriber row — an
  // Organization has no public page of its own (see CustomDomain's model
  // comment for why it never owns one directly), so it gets
  // PlatformSubscription only, not CustomDomain.
  platformSubscriptions PlatformSubscription[]

  @@index([businessId])
}

// phase-14 spec §3.1: deliberately separate from BusinessMember — "is an
// employee for HR/SSO/audit purposes" and "can post as the company
// publicly" are different permission questions. Granting BusinessMember
// access, even on a linked Business, always stays a separate, explicit
// action through Phase 4's own flow (never implied by this row existing).
model OrganizationMember {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // org_admin | member
  department     String?
  title          String?
  status         String       @default("active") // active | deactivated
  joinedAt       DateTime     @default(now())

  @@id([organizationId, userId])
  @@index([userId])
}

// phase-14 spec §5.1: the reverse role from Phase 10's identity-provider
// work — here 0dot is the service provider trusting an enterprise
// customer's own IdP (Okta/Azure AD/Google Workspace/etc.) via SAML2 or
// OIDC. idpMetadataJson holds whichever protocol's own connection details
// (SAML: IdP entity ID/certificate/metadata XML; OIDC: issuer/client
// credentials/JWKS endpoint) — a plain String, same "no native Json
// scalar" convention as every other ...Json column in this schema.
// `enforced` gates organization-scoped access only (§5.3) — see
// requireOrgAccess in organizations.ts for what that means in practice;
// it never disables a user's other login methods for their personal
// account (auth.ts's login() is untouched by this model).
model SSOConnection {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  protocol        String // saml2 | oidc
  idpMetadataJson String
  enforced        Boolean      @default(false)
  createdAt       DateTime     @default(now())

  identities SSOIdentity[]
}

// spec §5.2: links one 0dot User to the IdP's own subject/NameID for them.
// JIT provisioning (provisionOrLinkUserForSso, sso.ts) either creates this
// against a fresh User or an existing one matched by verified email —
// never a second, walled-off "enterprise identity" (§5.2/mission
// principle "One Identity, One Profile").
model SSOIdentity {
  id                String        @id @default(uuid())
  ssoConnectionId   String
  ssoConnection     SSOConnection @relation(fields: [ssoConnectionId], references: [id], onDelete: Cascade)
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalSubjectId String
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())

  @@unique([ssoConnectionId, externalSubjectId])
  @@index([userId])
}

// phase-14 spec §7.1: same append-only, actor-attributed shape as
// ModAction (Phase 3 §13.1 named this phase as ModAction's "direct
// precedent") — reused rather than inventing a fourth, subtly different
// audit-log shape alongside ModAction/PaymentTransaction/TrustSafetyCase.
// Kept as its own table despite the shared shape (§7.2): the audience is
// an organization's own admins reviewing their own history, not 0dot's
// Trust & Safety staff, so merging into TrustSafetyCase would leak
// unrelated data across that boundary either direction.
model OrganizationAuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String // member_added | member_removed | member_deactivated | sso_connection_configured | sso_enforcement_changed | community_created | org_settings_changed
  targetType     String?
  targetId       String?
  metadataJson   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// phase-15 spec §4.1: push as a third delivery channel on the existing
// Notification.type catalog (§4.2) — resolves the push deferrals scattered
// across Phase 2 §4.3, Phase 5 §12, Phase 8 §8.3. appClientId ties a token
// to whichever first-party DeveloperApp (§3) registered it, so revoking
// that app's OAuthAuthorization (revokeOAuthAuthorization, oauth.ts) can
// also clear its device tokens (§4.4's "revoking/logging out clears the
// associated DeviceToken" acceptance criterion).
model DeviceToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String // ios | android | web_push
  token       String
  appClientId String
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, token])
  @@index([appClientId])
}

// phase-15 spec §4.1: per-user, per-type, per-channel opt-out — in_app is
// never actually gated through this (Phase 2's core loop doesn't offer an
// opt-out), but push/email rows are read by dispatchPushEvent (push.ts)
// before a send, defaulting to enabled when no row exists (spec: "enabled
// boolean, default true").
model NotificationDeliveryPreference {
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationType String
  channel          String // in_app | push | email
  enabled          Boolean @default(true)

  @@id([userId, notificationType, channel])
}

// phase-15 spec §6.3: Apple/Google pay out IAP revenue as one aggregated
// lump sum to 0dot itself, unlike Stripe Connect's direct per-creator
// payout — this is the reconciliation unit that lump sum is tracked
// against before per-creator disbursement through CreatorPayoutAccount.
// Deliberately minimal (status transitions only) — spec §6.3 flags the
// full reconciliation/finance workflow as its own dedicated undertaking,
// not something this schema addition alone resolves.
model IapPayoutBatch {
  id          String   @id @default(uuid())
  processor   String // apple_iap | google_play_billing
  amount      Float // aggregated lump sum received from the store
  currency    String   @default("usd")
  periodStart DateTime
  periodEnd   DateTime
  status      String   @default("received") // received | reconciled | disbursed
  createdAt   DateTime @default(now())

  transactions PaymentTransaction[]
}

// ===== Phase 16: Future Modules =====
// phase-16 spec §4: a saved search over Phase 4's existing Job table — no
// new Job-equivalent table, same "query-time union, not a master table"
// principle as Phase 9 §6.1's Marketplace browse.
model JobAlert {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filterCriteria String // JSON: {location, remote, employmentType, keywords}
  createdAt      DateTime @default(now())

  @@index([userId])
}

// phase-16 spec §6: a thin config layer over Profile/WorkExperience —
// no second identity representation, same canonical profile URL Phase 1
// §3.4's QR code already resolves to.
model DigitalBusinessCard {
  profileId      String   @id
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  includedFields String // JSON array of Profile/ContactInfo/WorkExperience field keys to show on the card
  enabled        Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

// phase-16 spec §7: general-purpose shortener, the third instance of the
// "short code + click analytics" pattern (Link, AffiliateLink). A new
// primitive, not a retrofit onto either existing one (spec §7.2).
model ShortLink {
  id             String   @id @default(uuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shortCode      String   @unique
  destinationUrl String // scheme-validated by isSafeUrl, same rule as Phase 1 §4.2's link URLs
  clickCount     Int      @default(0)
  createdAt      DateTime @default(now())

  clicks ShortLinkClick[]

  @@index([ownerId])
}

model ShortLinkClick {
  id           String    @id @default(uuid())
  shortLinkId  String
  shortLink    ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  occurredAt   DateTime  @default(now())
  referrerHost String? // no raw IP/UA, same posture as every click-analytics table since Phase 1 §4.3

  @@index([shortLinkId])
}

// phase-16 spec §8: the one new entity a personal calendar needs.
// Appointment/EventRSVP+Ticket are queried live at view time, never copied
// in here — same query-time-union principle as JobAlert above.
model CalendarEntry {
  id        String    @id @default(uuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String // 1-120 chars, validated at the app layer
  startsAt  DateTime
  endsAt    DateTime?

  @@index([profileId, startsAt])
}

// phase-16 spec §9: forms and surveys share one table (mode is
// presentation/analytics emphasis only, never a schema difference) — same
// reasoning Phase 7 §5.2 applied to Documentation vs. Wiki. Four-way owner
// XOR enforced at the app layer, no partial-index/CHECK support in this
// Prisma+SQLite setup (same limitation Link/ProjectCollaborator work
// around).
model Form {
  id                  String        @id @default(uuid())
  ownerType           String // profile | business | organization | community
  ownerProfileId      String?
  ownerProfile        Profile?      @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  ownerBusinessId     String?
  ownerBusiness       Business?     @relation(fields: [ownerBusinessId], references: [id], onDelete: Cascade)
  ownerOrganizationId String?
  ownerOrganization   Organization? @relation(fields: [ownerOrganizationId], references: [id], onDelete: Cascade)
  ownerCommunityId    String?
  ownerCommunity      Community?    @relation(fields: [ownerCommunityId], references: [id], onDelete: Cascade)
  title               String // 1-160 chars, validated at the app layer
  fieldsJson          String // JSON array: [{label, type: text|choice|rating|date, required, options}]
  mode                String        @default("form") // form | survey — presentation/analytics emphasis only
  status              String        @default("draft") // draft | published | closed
  createdAt           DateTime      @default(now())

  responses FormResponse[]

  @@index([ownerProfileId])
  @@index([ownerBusinessId])
  @@index([ownerOrganizationId])
  @@index([ownerCommunityId])
}

model FormResponse {
  id           String   @id @default(uuid())
  formId       String
  form         Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  respondentId String?
  respondent   User?    @relation(fields: [respondentId], references: [id], onDelete: SetNull)
  answersJson  String // JSON object keyed by field label
  submittedAt  DateTime @default(now())

  @@index([formId])
}

// phase-16 spec §11: structurally close to Tip (Phase 5 §6), extended with
// an optional fundraising goal — the fourth reuse of the PaymentTransaction
// ledger. Three-way organizer XOR, same width as Phase 8's Event hosting.
model FundraisingCampaign {
  id                      String        @id @default(uuid())
  organizerType           String // user | business | organization
  organizerUserId         String?
  organizerUser           User?         @relation("FundraisingCampaignOrganizerUser", fields: [organizerUserId], references: [id], onDelete: Cascade)
  organizerBusinessId     String?
  organizerBusiness       Business?     @relation(fields: [organizerBusinessId], references: [id], onDelete: Cascade)
  organizerOrganizationId String?
  organizerOrganization   Organization? @relation(fields: [organizerOrganizationId], references: [id], onDelete: Cascade)
  title                   String // 1-160 chars, validated at the app layer
  goalAmount              Float? // nullable = ongoing, no stated goal
  currency                String
  raisedAmount            Float         @default(0) // denormalized, same pattern used throughout
  endsAt                  DateTime?
  status                  String        @default("active") // active | completed | cancelled
  createdAt               DateTime      @default(now())

  donations Donation[]

  @@index([organizerUserId])
  @@index([organizerBusinessId])
  @@index([organizerOrganizationId])
}

// spec §11: is_anonymous hides the donor's identity from *public* display
// only — the organizer still sees who donated, same "anonymous to whom"
// distinction Phase 12 §4.2/Phase 13 §4.2 drew for reporter anonymity vs.
// DMCA complainant disclosure.
model Donation {
  id                   String               @id @default(uuid())
  campaignId           String?
  campaign             FundraisingCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade) // nullable = a direct donation, same shape as a Tip
  donorId              String
  donor                User                 @relation(fields: [donorId], references: [id], onDelete: Cascade)
  amount               Float
  currency             String
  message              String?
  isAnonymous          Boolean              @default(false)
  paymentTransactionId String               @unique
  paymentTransaction   PaymentTransaction   @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  createdAt            DateTime             @default(now())

  @@index([campaignId])
  @@index([donorId])
}

// phase-16 spec §12: extends Phase 5's Course/CourseModule/Lesson with
// cross-course curricula and assessment — no second Course-equivalent
// content table.
model LearningPath {
  id            String   @id @default(uuid())
  creatorId     String
  creator       User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title         String // 1-160 chars, validated at the app layer
  courseIdsJson String // JSON array of ordered Course id references
  createdAt     DateTime @default(now())

  @@index([creatorId])
}

model Quiz {
  id            String   @id @default(uuid())
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questionsJson String // JSON array of question objects
  passingScore  Int
  createdAt     DateTime @default(now())

  attempts QuizAttempt[]

  @@index([lessonId])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int
  passed      Boolean
  attemptedAt DateTime @default(now())

  @@index([quizId, userId])
}

// phase-16 spec §13: deliberately narrow MVP — fixed three-stage pipeline,
// not business-configurable, same scope-limit posture as this series'
// other flagged heavy sub-efforts.
model Contact {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull) // linked if this contact already has a 0dot account
  externalName  String?
  externalEmail String?
  stage         String   @default("lead") // lead | customer | churned — fixed pipeline, not configurable
  notes         String?
  createdAt     DateTime @default(now())

  activities Activity[]

  @@index([businessId, stage])
  @@index([userId])
}

// Most rows are derived automatically from existing touchpoints
// (ContactMessage/Appointment/OfferingPurchase) rather than manually
// re-entered — spec §13.2.
model Activity {
  id           String   @id @default(uuid())
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activityType String // contact_message | appointment | purchase | manual_note
  sourceId     String? // the originating ContactMessage/Appointment/OfferingPurchase row id, when derived
  occurredAt   DateTime @default(now())

  @@index([contactId, occurredAt])
}

// Coin wallet top-up, funded by UPI (no payment gateway) — the user pays the
// platform's own UPI VPA directly (upi.ts builds the deep link/QR embedding
// referenceCode as the "tn" note), then submits the UTR they got from their
// UPI app as proof. There's no webhook/API confirming the payment landed, so
// an admin manually cross-checks the UTR against the platform's own bank/UPI
// statement before approving (wallet.ts) and crediting User.coinBalance.
// Deliberately not a PaymentTransaction row — that ledger is Stripe's
// money-movement record; this is an unrelated, wholly separate primitive.
model CoinTopUpRequest {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinAmount       Int // coins requested, 1 coin = $1 (see USD_COIN_TO_INR_RATE in upi.ts)
  amountInr        Int // the actual INR amount the UPI deep link asks for, captured at creation time (not recomputed later) so a later exchange-rate change never rewrites what a pending/past request expected to be paid
  referenceCode    String    @unique // embedded in the UPI deep link's "tn" param so a payment is matchable back to this row
  status           String    @default("pending_payment") // pending_payment | submitted | approved | rejected
  utr              String? // user-submitted UPI transaction/reference number, set on submit
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNote       String?
  createdAt        DateTime  @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

// Coin-to-cash payout, the reverse of CoinTopUpRequest — coinBalance is
// debited up front (escrow-style, at request time, not at payment time) so
// a user can't also spend the same coins elsewhere while a payout is
// pending. Same "no payment gateway" posture: an admin manually sends the
// money via UPI to the snapshotted vpa outside the app, then marks this
// paid with whatever reference their UPI app gave them. vpa is snapshotted
// rather than read live off User.payoutUpiVpa at payout time so a later
// address change can never retroactively change where an
// already-requested-or-paid payout is understood to have gone.
// User-to-user coin transfer — a plain append-only ledger row (unlike
// coinBalance itself, which is a mutable running total on User). No status
// field: unlike CoinTopUpRequest/CoinPayoutRequest there's no external
// step to wait on, the transfer either fully lands in one transaction or
// doesn't happen at all (wallet.ts's transferCoinsAction).
model CoinTransfer {
  id         String   @id @default(uuid())
  fromUserId String
  fromUser   User     @relation("CoinTransferSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("CoinTransferReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  amount     Int
  createdAt  DateTime @default(now())

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

model CoinPayoutRequest {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinAmount       Int // debited from coinBalance at request time
  amountInr        Int // computed via coinsToInr at request time, same peg/rounding as the top-up side
  vpa              String // snapshot of User.payoutUpiVpa at request time
  status           String    @default("pending") // pending | paid | rejected
  paidReference    String? // UTR/reference the admin used to send the money, set when marking paid
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNote       String?
  createdAt        DateTime  @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}
